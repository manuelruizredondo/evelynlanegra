---
const { actual } = Astro.props;
const sub = [
  { href: "/interno/carteles/", label: "Competidor" },
  { href: "/interno/carteles-ganadores/", label: "Ganadores" },
  { href: "/interno/carteles-generados/", label: "Generados" },
];
---
<div class="subnav">
  {sub.map((s) => (
    <a href={s.href} class:list={["subnav__a", { "subnav__a--on": s.href === actual }]}>{s.label}</a>
  ))}
</div>
<style>
  .subnav{display:inline-flex;gap:3px;padding:3px;border-radius:999px;
    background:#f1f1f4;border:1px solid #e4e4e8;margin:0 0 22px}
  .subnav__a{display:block;padding:7px 17px;border-radius:999px;color:#6d6d76;
    font-size:.8rem;font-weight:600;text-decoration:none}
  .subnav__a:hover{color:#15151a;text-decoration:none}
  .subnav__a--on{background:#fff;color:#15151a;box-shadow:0 1px 3px rgba(0,0,0,.09)}
</style>
