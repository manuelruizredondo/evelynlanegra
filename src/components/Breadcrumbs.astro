---
// Migas de pan. `items` = [{label, href?}] — el último va sin href (página actual).
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Migas de pan">
  <ol>
    {items.map((c, i) => (
      <>
        {i > 0 && (
          <li aria-hidden="true" class="crumbs__sep">
            <svg viewBox="0 0 24 24" width="14" height="14"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </li>
        )}
        <li class={c.href ? "" : "crumbs__current"} {...(c.href ? {} : { "aria-current": "page" })}>
          {c.href ? <a href={c.href}>{c.label}</a> : c.label}
        </li>
      </>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol{list-style:none;display:flex;align-items:center;gap:10px;margin:0;padding:0;
    font-size:.82rem;font-weight:600;min-width:0}
  .crumbs li{display:flex;align-items:center;min-width:0}
  .crumbs a{color:var(--muted);text-decoration:none;white-space:nowrap}
  .crumbs a:hover{color:var(--acc);text-decoration:none}
  .crumbs__sep{color:#4a4a4e;flex:0 0 auto}
  .crumbs__current{color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  @media (max-width:600px){ .crumbs__current{max-width:45vw} }
</style>
