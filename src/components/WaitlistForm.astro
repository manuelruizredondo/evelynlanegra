---
// Lista de espera del curso online, que aún está en preparación.
// Netlify Forms: funciona sin JS igual que el formulario de contacto.
import { getLocale, localize, ui } from "../i18n";
const locale = getLocale(Astro.url);
const f = ui[locale].form;
const w = ui[locale].waitlist;
const { name = "lista-espera-online" } = Astro.props;
const action = localize("/gracias/", locale);
const privacy = localize("/privacidad/", locale);
const disciplinas = ["Bachata", "Salsa", "Ball room"];
---
<section class="section" id="lista-espera">
  <div class="container readcol">
    <div class="wait">
      <p class="eyebrow">{w.kicker}</p>
      <h2 class="wait__title">{w.title}</h2>
      <p class="wait__note">{w.note}</p>

      <form name={name} method="POST" action={action} data-netlify="true" netlify-honeypot="bot-field" class="wait__form">
        <input type="hidden" name="form-name" value={name} />
        <p hidden><label>{f.noFill}: <input name="bot-field" /></label></p>

        <div class="wait__row">
          <label class="wait__field"><span>{w.nombre}</span><input type="text" name="nombre" required /></label>
          <label class="wait__field"><span>{w.apellidos}</span><input type="text" name="apellidos" required /></label>
        </div>

        <div class="wait__row">
          <label class="wait__field">
            <span>{w.artistico} <em class="wait__hint">({w.artisticoHint})</em></span>
            <input type="text" name="nombre-artistico" />
          </label>
          <label class="wait__field"><span>{w.instagram}</span><input type="text" name="instagram" placeholder="@" /></label>
        </div>

        <div class="wait__row">
          <label class="wait__field"><span>{w.email}</span><input type="email" name="email" required /></label>
          <label class="wait__field">
            <span>{w.telefono}</span>
            <input type="tel" name="telefono" placeholder="+34 600 000 000" required />
            <small class="wait__help">{w.telefonoHint}</small>
          </label>
        </div>

        <div class="wait__row">
          <label class="wait__field"><span>{w.ciudad}</span><input type="text" name="ciudad" /></label>
          <label class="wait__field"><span>{w.pais}</span><input type="text" name="pais" /></label>
        </div>

        <fieldset class="wait__fieldset">
          <legend>{w.disciplinas}</legend>
          <div class="wait__checks">
            {disciplinas.map((d) => (
              <label class="wait__check">
                <input type="checkbox" name="disciplinas" value={d} />
                <span>{d}</span>
              </label>
            ))}
          </div>
          <input type="text" name="otras-disciplinas" placeholder={w.otras} class="wait__otras" />
        </fieldset>

        <div class="wait__row">
          <label class="wait__field"><span>{w.experiencia}</span><input type="text" name="experiencia" /></label>
          <label class="wait__field"><span>{w.comoConociste}</span><input type="text" name="como-conociste" /></label>
        </div>

        <label class="wait__field">
          <span>{w.expectativas}</span>
          <textarea name="expectativas" rows="4"></textarea>
        </label>

        <label class="wait__consent">
          <input type="checkbox" name="consentimiento" value="si" required />
          <span>{f.consent} <a href={privacy} target="_blank" rel="noopener">{f.consentLink}</a>.</span>
        </label>

        <button class="btn btn--red btn--lg" type="submit">{w.cta}</button>
      </form>

      <p class="wait__promise">{w.promise}</p>
    </div>
  </div>
</section>

<style>
  .wait{border:1px solid var(--line);border-radius:18px;background:var(--bg2);padding:34px}
  .wait__title{color:#fff;margin:0 0 .4em}
  .wait__note{color:var(--text);margin:0 0 26px;max-width:56ch}
  .wait__form{display:grid;gap:16px}
  .wait__row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .wait__field{display:flex;flex-direction:column;gap:6px;font-weight:700;color:#fff;font-size:.78rem;
    text-transform:uppercase;letter-spacing:.05em}
  .wait__hint{font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted);font-style:normal}
  .wait__field input,.wait__field textarea{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;
    padding:13px 16px;border:1px solid var(--line);border-radius:10px;width:100%;
    background:var(--bg);color:#fff}
  .wait__field input:focus,.wait__field textarea:focus{outline:none;border-color:var(--acc)}
  .wait__field input::placeholder,.wait__field textarea::placeholder{color:var(--muted)}
  .wait__help{font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted);font-size:.78rem}
  .wait__fieldset{border:0;padding:0;margin:0;display:grid;gap:12px}
  .wait__fieldset legend{padding:0;font-weight:700;color:#fff;font-size:.78rem;
    text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
  .wait__checks{display:flex;flex-wrap:wrap;gap:10px}
  .wait__check{display:flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid var(--line);
    border-radius:999px;background:var(--bg);color:var(--text);font-size:.9rem;cursor:pointer}
  .wait__check input{width:auto;accent-color:var(--acc);margin:0}
  .wait__check:has(input:checked){border-color:var(--acc);color:#fff}
  .wait__otras{font:inherit;padding:13px 16px;border:1px solid var(--line);border-radius:10px;width:100%;
    background:var(--bg);color:#fff}
  .wait__otras:focus{outline:none;border-color:var(--acc)}
  .wait__otras::placeholder{color:var(--muted)}
  .wait__consent{display:flex;align-items:flex-start;gap:10px;font-size:.85rem;color:var(--text)}
  .wait__consent input{width:auto;margin-top:2px;accent-color:var(--acc)}
  .wait__consent a{color:var(--acc)}
  .wait__form button{justify-self:start;border:0}
  .wait__promise{margin:18px 0 0;color:var(--muted);font-size:.82rem}
  @media (max-width:600px){
    .wait{padding:26px 22px}
    .wait__row{grid-template-columns:1fr}
  }
</style>
