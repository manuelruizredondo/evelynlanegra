---
import Base from "../../layouts/Base.astro";
// Uso interno: no se indexa y /interno/ está bloqueado en robots.txt.
// Los datos no viajan al navegador hasta que el servidor valida la contraseña.
---
<Base title="Lista de espera · uso interno" description="Listado interno de formularios recibidos." noindex={true}>
  <section class="section li">
    <div class="li__ancho">
      <p class="eyebrow">Uso interno</p>
      <h1 class="li__h1">Formularios recibidos</h1>

      <form class="li__login" data-login>
        <label>
          <span>Contraseña</span>
          <input type="password" name="clave" autocomplete="current-password" required />
        </label>
        <button class="btn btn--red" type="submit">Entrar</button>
        <p class="li__error" data-error hidden></p>
      </form>

      <div class="li__panel" data-panel hidden>
        <div class="li__barra">
          <label class="li__campo">
            <span>Formulario</span>
            <select data-formulario></select>
          </label>
          <label class="li__campo li__campo--ancho">
            <span>Buscar</span>
            <input type="search" data-buscar placeholder="nombre, email, ciudad…" />
          </label>
          <p class="li__contador" data-contador></p>
          <button class="btn btn--ghost" type="button" data-csv>Descargar CSV</button>
        </div>

        <p class="li__pista">Pulsa una fila con «+» para leer lo que escribió.</p>

        <div class="li__scroll">
          <table class="li__tabla">
            <colgroup data-colgroup></colgroup>
            <thead data-cabecera></thead>
            <tbody data-cuerpo></tbody>
          </table>
        </div>
        <p class="li__vacio" data-vacio hidden>Todavía no hay envíos en este formulario.</p>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Globales a propósito: la tabla la crea el JS y no recibiría los estilos limitados de Astro */
  .li{padding-top:calc(var(--header-h) + 30px)}
  /* A lo ancho de la pantalla: una tabla de 14 columnas no cabe en 1200px */
  .li__ancho{padding-inline:clamp(16px,3vw,40px);max-width:none}
  .li__h1{color:#fff;font-size:clamp(1.8rem,4vw,2.6rem);margin:8px 0 28px}

  .li__login{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;max-width:460px}
  .li__login[hidden]{display:none}
  .li__login label{display:flex;flex-direction:column;gap:6px;font-size:.75rem;font-weight:700;
    color:#fff;text-transform:uppercase;letter-spacing:.05em}
  .li__login input{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;padding:12px 15px;
    border:1px solid var(--line);border-radius:10px;background:var(--bg2);color:#fff;min-width:240px}
  .li__login input:focus{outline:none;border-color:var(--acc)}
  .li__login button{border:0}
  .li__error{width:100%;margin:6px 0 0;color:var(--acc);font-size:.88rem}

  .li__barra{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;margin-bottom:20px}
  .li__campo{display:flex;flex-direction:column;gap:6px;font-size:.72rem;font-weight:700;color:var(--muted);
    text-transform:uppercase;letter-spacing:.06em}
  .li__campo--ancho{flex:1 1 260px;max-width:420px}
  .li__campo select,.li__campo input{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;
    padding:10px 13px;border:1px solid var(--line);border-radius:9px;background:var(--bg2);color:#fff;width:100%}
  .li__campo select:focus,.li__campo input:focus{outline:none;border-color:var(--acc)}
  .li__contador{margin:0 auto 10px 0;color:#fff;font-weight:700;font-size:.9rem}
  .li__pista{margin:0 0 14px;color:var(--muted);font-size:.8rem}

  .li__scroll{overflow:auto;max-height:calc(100vh - 300px);
    border:1px solid var(--line);border-radius:12px;background:var(--bg2)}
  .li__tabla{border-collapse:separate;border-spacing:0;table-layout:fixed;width:max-content;min-width:100%;font-size:.85rem}

  .li__tabla th{color:#fff;font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;
    background:#16161a;position:sticky;top:0;z-index:2;white-space:nowrap;
    text-align:left;padding:13px 16px;border-bottom:1px solid var(--line)}
  .li__tabla td{padding:14px 16px;border-bottom:1px solid var(--line);
    vertical-align:top;color:var(--text);line-height:1.5}
  .li__tabla tbody tr:nth-child(even){background:rgba(255,255,255,.02)}
  .li__tabla tbody tr:hover{background:rgba(206,3,6,.07);cursor:pointer}

  /* Datos cortos: en una línea, sin romperse */
  .li__tabla td.corta{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .li__tabla tr.abierta td.corta{white-space:normal;overflow:visible}
  .li__tabla td.fecha{color:var(--muted);font-size:.78rem}
  .li__tabla td.dato-nombre{color:#fff;font-weight:600}
  .li__tabla td.vacia{color:#4a4a4e}

  /* Texto largo: sitio de sobra y recortado a 4 líneas hasta que se pulsa */
  .li__toggle{color:var(--acc);font-weight:700;text-align:center;user-select:none}
  .li__tabla tr.detalle td{background:#101014;padding:0;white-space:normal}
  .li__ficha{position:sticky;left:0;width:min(1000px,calc(100vw - 6vw - 40px));padding:18px 22px 20px}
  .li__bloque{margin:0 0 16px;max-width:90ch}
  .li__bloque:last-child{margin-bottom:0}
  .li__k{margin:0 0 4px;color:var(--acc);font-size:.66rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.08em}
  .li__v{margin:0;color:#fff;line-height:1.6;white-space:pre-line}
  .li__tabla tr.abierta{background:rgba(206,3,6,.05)}

  .li__tabla td a{color:var(--acc);text-decoration:none}
  .li__tabla td a:hover{text-decoration:underline}
  .li__vacio{color:var(--muted);margin-top:18px}
</style>

<script>
  const $ = (s) => document.querySelector(s);
  const login = $("[data-login]"), panel = $("[data-panel]"), error = $("[data-error]");
  const selForm = $("[data-formulario]"), buscar = $("[data-buscar]");
  const grupo = $("[data-colgroup]"), cabecera = $("[data-cabecera]"), cuerpo = $("[data-cuerpo]");
  const contador = $("[data-contador]"), vacio = $("[data-vacio]"), btnCsv = $("[data-csv]");

  // La contraseña vive solo en memoria: al recargar se vuelve a pedir.
  let clave = "";
  let envios = [];
  let columnas = [];

  const OCULTAS = ["bot-field", "form-name"];
  // Estos no caben en una columna: van en la ficha desplegable
  const FICHA = ["expectativas", "mensaje", "como-conociste"];
  const ANCHOS = {
    fecha: 108, nombre: 130, apellidos: 145, "nombre-artistico": 130, instagram: 175,
    email: 235, telefono: 150, ciudad: 120, pais: 110, experiencia: 95, consentimiento: 80,
    disciplinas: 190, "otras-disciplinas": 170, "como-conociste": 300, expectativas: 380, mensaje: 380,
  };
  const ancho = (c) => ANCHOS[c] ?? 155;
  const ETIQUETAS = {
    "nombre-artistico": "N. artístico", "otras-disciplinas": "Otras discipl.",
    "como-conociste": "Cómo conoció", "consentimiento": "RGPD",
  };
  const etiqueta = (k) => ETIQUETAS[k] ?? k.charAt(0).toUpperCase() + k.slice(1);

  const pedir = async (formulario) => {
    const r = await fetch("/.netlify/functions/lista-espera", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ clave, formulario }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || "Error inesperado");
    return data;
  };

  const fecha = (iso) => {
    try { return new Date(iso).toLocaleString("es-ES", { day: "2-digit", month: "short", year: "2-digit", hour: "2-digit", minute: "2-digit" }); }
    catch { return iso; }
  };

  const escapar = (s) => String(s).replace(/[<>&"]/g, (m) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" }[m]));

  // Emails y teléfonos, pulsables; el resto, texto plano
  const celda = (campo, valor) => {
    const v = Array.isArray(valor) ? valor.join(", ") : (valor ?? "");
    const texto = String(v).trim();
    if (!texto) return `<td class="vacia">—</td>`;

    if (campo === "email") return `<td class="corta"><a href="mailto:${escapar(texto)}">${escapar(texto)}</a></td>`;
    if (campo === "telefono") {
      const limpio = texto.replace(/[^+\d]/g, "");
      return `<td class="corta"><a href="https://wa.me/${limpio.replace(/^\+/, "")}" target="_blank" rel="noopener">${escapar(texto)}</a></td>`;
    }
    if (campo === "instagram") {
      const usuario = texto.replace(/^@/, "");
      return `<td class="corta"><a href="https://instagram.com/${escapar(usuario)}" target="_blank" rel="noopener">@${escapar(usuario)}</a></td>`;
    }
    if (campo === "nombre" || campo === "apellidos") return `<td class="corta dato-nombre">${escapar(texto)}</td>`;
    return `<td class="corta">${escapar(texto)}</td>`;
  };

  const pintar = () => {
    const q = buscar.value.trim().toLowerCase();
    const filas = q
      ? envios.filter((e) => JSON.stringify(e.datos).toLowerCase().includes(q))
      : envios;

    contador.textContent = filas.length === envios.length
      ? `${envios.length} ${envios.length === 1 ? "envío" : "envíos"}`
      : `${filas.length} de ${envios.length}`;

    const enTabla = columnas.filter((c) => !FICHA.includes(c));
    const enFicha = columnas.filter((c) => FICHA.includes(c));

    grupo.innerHTML = [`<col style="width:${ancho("fecha")}px">`, `<col style="width:34px">`,
      ...enTabla.map((c) => `<col style="width:${ancho(c)}px">`)].join("");
    cabecera.innerHTML = `<tr><th>Fecha</th><th></th>${enTabla.map((c) => `<th>${etiqueta(c)}</th>`).join("")}</tr>`;

    const total = enTabla.length + 2;
    cuerpo.innerHTML = filas.map((e, i) => {
      const textos = enFicha
        .map((c) => [etiqueta(c), String(e.datos[c] ?? "").trim()])
        .filter(([, v]) => v);

      const resumen =
        `<tr class="fila" data-fila="${i}">` +
        `<td class="fecha">${fecha(e.fecha)}</td>` +
        `<td class="li__toggle">${textos.length ? "<span>+</span>" : ""}</td>` +
        enTabla.map((c) => celda(c, e.datos[c])).join("") +
        `</tr>`;

      const detalle = textos.length
        ? `<tr class="detalle" data-detalle="${i}" hidden><td colspan="${total}"><div class="li__ficha">` +
          textos.map(([k, v]) => `<div class="li__bloque"><p class="li__k">${k}</p><p class="li__v">${escapar(v)}</p></div>`).join("") +
          `</div></td></tr>`
        : "";

      return resumen + detalle;
    }).join("");

    vacio.hidden = envios.length > 0;
  };

  const cargar = async (formulario) => {
    const data = await pedir(formulario);

    if (selForm.options.length === 0) {
      selForm.innerHTML = data.formularios
        .map((f) => `<option value="${f.name}">${f.name} (${f.count})</option>`).join("");
    }
    if (data.actual) selForm.value = data.actual;

    envios = data.envios ?? [];
    const vistas = new Set();
    envios.forEach((e) => Object.keys(e.datos).forEach((k) => { if (!OCULTAS.includes(k)) vistas.add(k); }));
    columnas = [...vistas];
    pintar();
  };

  login.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    error.hidden = true;
    clave = login.clave.value;
    const btn = login.querySelector("button");
    btn.disabled = true; btn.textContent = "Comprobando…";
    try {
      await cargar();
      login.hidden = true;
      panel.hidden = false;
    } catch (e) {
      clave = "";
      error.textContent = e.message;
      error.hidden = false;
    } finally {
      btn.disabled = false; btn.textContent = "Entrar";
    }
  });

  selForm.addEventListener("change", () => cargar(selForm.value).catch((e) => alert(e.message)));
  buscar.addEventListener("input", pintar);

  // Al pulsar una fila se despliega el texto recortado (salvo si se pulsa un enlace)
  cuerpo.addEventListener("click", (ev) => {
    if (ev.target.closest("a")) return;
    const fila = ev.target.closest("tr.fila");
    if (!fila) return;
    const detalle = cuerpo.querySelector(`[data-detalle="${fila.dataset.fila}"]`);
    if (!detalle) return;
    detalle.hidden = !detalle.hidden;
    fila.classList.toggle("abierta", !detalle.hidden);
    const signo = fila.querySelector(".li__toggle span");
    if (signo) signo.textContent = detalle.hidden ? "+" : "−";
  });

  btnCsv.addEventListener("click", () => {
    const esc = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
    const cab = ["fecha", ...columnas].map(esc).join(",");
    const filas = envios.map((e) =>
      [e.fecha, ...columnas.map((c) => (Array.isArray(e.datos[c]) ? e.datos[c].join(" | ") : e.datos[c]))]
        .map(esc).join(","));
    const csv = "﻿" + [cab, ...filas].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
    a.download = `${selForm.value || "formulario"}-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
