---
// Conmutador entre las dos páginas del área privada.
const { actual } = Astro.props;
const enlaces = [
  { href: "/interno/lista-espera/", label: "Formularios" },
  { href: "/interno/medios/", label: "Fotos y vídeos" },
  { href: "/interno/portadas/", label: "Portadas" },
  { href: "/interno/carteles/", label: "Carteles" },
  { href: "/interno/chyrons/", label: "Chyrons" },
];
---
<nav class="in-nav" aria-label="Área privada">
  <div class="in-nav__caja">
    {enlaces.map((e) => (
      <a
        href={e.href}
        class:list={["in-nav__a", { "in-nav__a--activo": e.href === actual }]}
        {...(e.href === actual ? { "aria-current": "page" } : {})}
      >{e.label}</a>
    ))}
    <a class="in-nav__a in-nav__salir" href="?salir" title="Cerrar la sesión de uso interno">Salir</a>
  </div>
</nav>

<style>
  /* Se coloca dentro de la franja de cabecera, a la misma altura que el logo
     y la hamburguesa. Sin capturar clics salvo en las propias pastillas. */
  .in-nav{position:fixed;top:0;left:0;right:0;height:var(--header-h);
    display:flex;align-items:center;justify-content:center;
    /* Por encima de la cabecera: su franja interior ocupa todo el ancho
       y se quedaba con los clics de las pastillas */
    z-index:1002;pointer-events:none;padding:0 16px}
  .in-nav__caja{pointer-events:auto}
  /* Con el menú abierto estorbaría por encima del panel */
  :global(body.nav-open) .in-nav{opacity:0;pointer-events:none}
  .in-nav__caja{display:inline-flex;gap:4px;padding:4px;border-radius:999px;
    background:#f1f1f4;border:1px solid #e4e4e8}
  .in-nav__a{display:block;padding:9px 20px;border-radius:999px;
    color:#6d6d76;font-size:.85rem;font-weight:600;text-decoration:none;
    transition:background .15s,color .15s}
  .in-nav__a:hover{color:#15151a;text-decoration:none}
  .in-nav__a--activo{background:#fff;color:#15151a;box-shadow:0 1px 3px rgba(0,0,0,.09)}
  .in-nav__salir{margin-left:6px;padding-left:16px;padding-right:16px;
    border-left:1px solid #dcdce2;border-radius:0 999px 999px 0;font-size:.8rem}
  .in-nav__salir:hover{color:#ce0306}

  /* En el móvil no cabe la píldora centrada: las cinco pastillas miden 492 px
     y la pantalla 375, así que se cortaba por los dos lados y «Salir» no se
     veía. Aquí pasa a ser una franja de ancho completo que se arrastra con el
     dedo, y ocupa el sitio de la cabecera del sitio, que dentro de una
     herramienta no pinta nada y además ya quedaba tapada por esta barra. */
  @media (max-width:760px){
    :global(html:has(.in-nav)){--header-h:56px}
    :global(html:has(.in-nav) .site-header){display:none}
    /* El botón flotante de WhatsApp se plantaba encima de los controles */
    :global(html:has(.in-nav) .wa-fab){display:none}
    .in-nav{padding:0;background:#f1f1f4;border-bottom:1px solid #e4e4e8;
      pointer-events:auto;justify-content:flex-start}
    .in-nav__caja{width:100%;height:100%;padding:0 8px;gap:2px;
      background:none;border:0;border-radius:0;flex-wrap:nowrap;
      overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .in-nav__caja::-webkit-scrollbar{display:none}
    .in-nav__a{flex:0 0 auto;padding:7px 13px;font-size:.8rem;white-space:nowrap}
    .in-nav__salir{margin-left:2px;padding-left:12px;padding-right:12px;
      border-radius:999px}
    /* Degradado en el filo derecho: avisa de que la franja sigue */
    .in-nav::after{content:"";position:absolute;top:0;bottom:1px;right:0;width:30px;
      pointer-events:none;background:linear-gradient(to right,rgba(241,241,244,0),#f1f1f4)}
  }
</style>

<script>
  /* Si la franja no cabe, que al menos se vea dónde estás */
  const caja = document.querySelector(".in-nav__caja");
  const activo = caja?.querySelector(".in-nav__a--activo");
  if (caja && activo && caja.scrollWidth > caja.clientWidth) {
    caja.scrollLeft = activo.offsetLeft - (caja.clientWidth - activo.offsetWidth) / 2;
  }
</script>
