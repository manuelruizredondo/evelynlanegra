---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, date, cover } = post.data;
const fmt = (d) => d.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const url = new URL(`/blog/${post.slug}/`, Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: date.toISOString(),
      image: cover ? new URL(cover, Astro.site).href : undefined,
      author: { "@type": "Person", name: "Évelyn Viana Lovera", alternateName: "La Negra" },
      publisher: { "@type": "Organization", name: "La Negra Salsa" },
      mainEntityOfPage: url,
      inLanguage: "es",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).href },
        { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
        { "@type": "ListItem", position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<Base title={`${title} · Blog · La Negra`} description={description} image={cover ?? undefined} hasAlternates={false}>
  <article class="post">
    <header class="post__head">
      <div class="container">
        <div class="post__col">
          <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Blog", href: "/blog/" }, { label: title }]} />
          <p class="post__date">{fmt(date)}</p>
          <h1 class="post__title">{title}</h1>
        </div>
      </div>
    </header>

    {cover && (
      <div class="post__cover container">
        <img src={cover} alt={title} width="1200" height="675" />
      </div>
    )}

    <div class="container">
      <div class="prose post__body">
        <Content />
      </div>

      <aside class="post__author">
        <img src="/img/evelyn.png" alt="Évelyn «La Negra»" width="72" height="72" loading="lazy" />
        <div>
          <p class="post__author-name">Évelyn Viana Lovera · «La Negra»</p>
          <p class="post__author-bio">
            Maestra y DJ de bachata dominicana y salsa. Periodista de formación, lleva treinta años
            en la pista y viajó a República Dominicana a estudiar la bachata en su origen. Creadora
            del Mundial de Pasos Libres y formadora de profesores en más de 40 países.
            <a href="/evelyn-la-negra/">Más sobre Évelyn</a>
          </p>
        </div>
      </aside>

      <aside class="post__cta">
        <h2>¿Bailamos?</h2>
        <p>Ven a una clase en Barcelona o Ibiza, o baila conmigo online desde donde estés.</p>
        <div class="post__cta-btns">
          <a class="btn btn--red btn--lg" href={site.whatsapp} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>
          <a class="btn btn--ghost btn--lg" href="/clases-presenciales/">Ver clases</a>
        </div>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
  .post__head{padding:calc(var(--header-h) + 40px) 0 24px}
  /* Columna de lectura: 760px centrada en la página, texto alineado a la izquierda */
  .post__col{max-width:var(--read);margin-inline:auto}
  /* Migas de pan */
  .crumbs ol{list-style:none;display:flex;align-items:center;gap:10px;margin:0;padding:0;
    font-size:.82rem;font-weight:600;min-width:0}
  .crumbs li{display:flex;align-items:center;min-width:0}
  .crumbs a{color:var(--muted);text-decoration:none;white-space:nowrap}
  .crumbs a:hover{color:var(--acc);text-decoration:none}
  .crumbs__sep{color:#4a4a4e;flex:0 0 auto}
  .crumbs__current{color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  @media (max-width:600px){
    .crumbs__current{max-width:45vw}
  }
  .post__date{color:var(--acc);font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin:18px 0 8px}
  .post__title{font-family:var(--serif);font-style:italic;font-weight:500;color:#fff;
    font-size:clamp(2rem,5vw,3.4rem);line-height:1.12;max-width:20ch;margin:0}
  .post__cover{margin:12px auto 40px}
  .post__cover img{width:100%;max-width:var(--read);margin-inline:auto;aspect-ratio:16/9;object-fit:cover;border-radius:16px;border:1px solid var(--line)}
  .post__body{max-width:var(--read);margin-inline:auto;color:#fff}
  .post__body :global(p),.post__body :global(li),.post__body :global(strong){color:#fff}
  .post__body :global(h2){font-family:var(--serif);font-style:italic;color:#fff;font-size:1.6rem;margin:1.8em 0 .5em}
  .post__body :global(blockquote){border-left:3px solid var(--acc);margin:1.4em 0;padding:.2em 0 .2em 20px;
    color:#fff;font-style:italic}
  .post__body :global(ol),.post__body :global(ul){padding-left:1.3em;line-height:1.7}
  .post__body :global(li){margin-bottom:.4em}
  .post__body :global(hr){border:0;border-top:1px solid var(--line);margin:2.4em 0}
  .post__body :global(a){color:var(--acc)}
  .post__author{max-width:var(--read);margin:44px auto 0;display:flex;gap:18px;align-items:flex-start;
    padding:22px 24px;border:1px solid var(--line);border-radius:16px;background:var(--bg2)}
  .post__author img{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:0 0 auto}
  .post__author-name{color:#fff;font-weight:700;margin:0 0 6px;font-size:.95rem}
  .post__author-bio{color:var(--text);font-size:.9rem;line-height:1.55;margin:0}
  .post__author-bio a{color:var(--acc)}
  @media (max-width:600px){.post__author{flex-direction:column}}

  .post__cta{max-width:var(--read);margin:44px auto 90px;padding:34px;border:1px solid var(--line);
    border-radius:18px;background:var(--bg2);text-align:center}
  .post__cta h2{color:#fff;margin:0 0 .3em}
  .post__cta p{color:var(--text);margin:0 0 22px}
  .post__cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
</style>
