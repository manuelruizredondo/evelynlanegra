---
import Base from "../../layouts/Base.astro";
import InternoNav from "../../components/InternoNav.astro";
import SubNavCarteles from "../../components/SubNavCarteles.astro";
import { CARTEL, PODIO, TOP10, HOJA, FASES } from "../../data/carteles";
import { BANDERAS, ES_EN } from "../../data/banderas";
const datos = JSON.stringify({ aro: CARTEL.aro, PODIO, TOP10, HOJA, FASES, BANDERAS, ES_EN });
---
<Base title="Carteles de ganadores · uso interno" description="Generador de carteles de podio." noindex={true}>
  <InternoNav actual="/interno/carteles/" />

  <section class="li">
    <div class="li__ancho">
      <p class="li__kicker">Uso interno</p>
      <h1 class="li__h1">Carteles</h1>
      <SubNavCarteles actual="/interno/carteles-ganadores/" />

      <div class="pt">
        <div class="pt__panel">
          <div class="pt__grupo">
            <p class="pt__t">Cartel</p>
            <div class="pt__tipos" data-tipos>
              <button type="button" class="pt__tipo pt__tipo--on" data-cartel="podio">Podio 1·2·3</button>
              <button type="button" class="pt__tipo" data-cartel="top10">Top 10</button>
            </div>
          </div>

          <div class="pt__grupo">
            <p class="pt__t">Título</p>
            <label class="pt__campo">
              <span>Categoría</span>
              <input type="text" data-titulo value="SEMIFINAL SOLISTA FEMENINO BACHATA" />
            </label>
            <p class="pt__pista" data-estado>Cargando la hoja…</p>
          </div>

          <div class="pt__grupo" data-puestos></div>

          <div class="pt__grupo">
            <p class="pt__t">Del 4 al 10</p>
            <label class="pt__campo">
              <span>Buscar</span>
              <input type="search" data-b-lista placeholder="nombre…" />
            </label>
            <div data-res-lista></div>
            <ol class="pt__orden" data-orden></ol>
            <p class="pt__pista" data-pista-lista></p>
          </div>


          <div class="pt__acciones">
            <button class="li__btn" type="button" data-descargar>Descargar PNG</button>
            <span class="pt__medida">1080 × 1440</span>
          </div>
        </div>

        <div class="pt__lienzo pt__lienzo--alto">
          <canvas data-canvas width="1080" height="1440"></canvas>
        </div>
      </div>
    </div>
  </section>
</Base>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap" />

<style is:global>
  .li{--li-tinta:#15151a;--li-suave:#6d6d76;--li-linea:#e4e4e8;--li-fondo:#fff;--li-alt:#f6f6f8;--li-acc:#ce0306;
    background:var(--li-fondo);color:var(--li-tinta);padding:calc(var(--header-h) + 8px) 0 70px;min-height:100vh}
  html,body{background:#fff !important}
  .li__ancho{padding-inline:clamp(16px,3vw,44px);max-width:1500px;margin-inline:auto}
  .li__kicker{margin:0 0 6px;color:var(--li-acc);font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em}
  .li__h1{color:var(--li-tinta);font-size:clamp(1.7rem,3.5vw,2.4rem);margin:0 0 14px}
  .li__btn{background:var(--li-acc);color:#fff;border:0;border-radius:9px;padding:12px 22px;
    font:inherit;font-weight:700;font-size:.85rem;cursor:pointer}
  .nav-toggle span{background:#15151a !important}
  .lang__btn{color:#15151a !important}
  .site-header.is-scrolled{background:rgba(255,255,255,.9) !important;border-bottom:1px solid #e4e4e8}

  .pt{display:grid;grid-template-columns:minmax(260px,350px) 1fr;gap:clamp(22px,2.5vw,38px);align-items:start}
  .pt__panel{display:grid;gap:18px;position:sticky;top:calc(var(--header-h) + 16px)}
  .pt__grupo{border:1px solid var(--li-linea);border-radius:13px;padding:16px;display:grid;gap:11px}
  .pt__t{margin:0;font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--li-suave)}
  .pt__campo{display:grid;gap:5px;font-size:.66rem;font-weight:700;color:var(--li-suave);
    text-transform:uppercase;letter-spacing:.06em}
  .pt__campo input[type=text],.pt__campo input[type=search],.pt__grupo textarea{
    font:inherit;font-weight:500;text-transform:none;letter-spacing:0;padding:9px 11px;
    border:1px solid var(--li-linea);border-radius:8px;background:#fff;color:var(--li-tinta);width:100%}
  .pt__grupo textarea{resize:vertical;font-size:.82rem;line-height:1.5}
  .pt__campo input:focus,.pt__grupo textarea:focus{outline:none;border-color:var(--li-acc)}
  .pt__campo input[type=file]{font-size:.74rem;font-weight:400;text-transform:none;letter-spacing:0}
  .pt__pista{margin:0;color:var(--li-suave);font-size:.73rem;line-height:1.45}
  /* La barra de acciones se queda pegada al fondo de la columna: el panel
     mide una pantalla y media larga y el botón principal quedaba sepultado
     en mitad del formulario. */
  .pt__acciones{display:flex;align-items:center;gap:14px;flex-wrap:wrap;
    position:sticky;bottom:0;z-index:2;margin:0 -4px;padding:12px 4px;
    background:linear-gradient(to top, var(--li-fondo) 72%, rgba(255,255,255,0));
    border-radius:10px}
  @media (max-width:900px){.pt__acciones{position:static;background:none;padding:0}}
  .pt__medida{color:var(--li-suave);font-size:.75rem}
  .pt__lienzo{border:1px solid var(--li-linea);border-radius:13px;overflow:hidden;background:#000;
    max-width:620px;margin-inline:auto}
  .pt__lienzo canvas{display:block;width:100%;height:auto;touch-action:none}
  /* El póster se queda a la vista mientras se recorre el formulario.
     El alto se limita al del hueco visible, y como el ancho sale del alto
     (lienzo de 1080x1440), nunca se recorta ni se deforma. */
  .pt__lienzo{position:sticky;top:calc(var(--header-h) + 16px)}
  .pt__lienzo--alto{max-width:min(620px, calc((100vh - var(--header-h) - 46px) * 0.75))}
  /* Resultados de la búsqueda: nombre arriba, categoría debajo y apagada */
  .pt__item{display:block;width:100%;text-align:left;background:none;border:0;cursor:pointer;
    padding:8px 11px;font:inherit;font-size:.82rem;font-weight:600;color:var(--li-tinta);
    border-bottom:1px solid var(--li-linea)}
  .pt__item:last-child{border-bottom:0}
  .pt__item:hover{background:var(--li-alt)}
  .pt__item small{display:block;margin-top:2px;color:var(--li-suave);
    font-size:.68rem;font-weight:500;line-height:1.3}
  [data-res]:not(:empty){border:1px solid var(--li-linea);border-radius:9px;overflow:hidden;
    max-height:210px;overflow-y:auto}
  .pt__puesto{border-top:1px solid var(--li-linea);padding-top:11px;display:grid;gap:8px}
  .pt__campo input[type=range]{accent-color:var(--li-acc);width:100%}
  .pt__campo select{border:1px solid var(--li-linea);border-radius:9px;padding:9px 10px;
    font:inherit;font-size:.82rem;font-weight:500;color:var(--li-tinta);background:#fff;
    text-transform:none;letter-spacing:0;width:100%}
  .pt__campo select:disabled{color:var(--li-suave);background:var(--li-alt)}
  .pt__reset{justify-self:start;background:var(--li-alt);border:1px solid var(--li-linea);
    border-radius:8px;padding:7px 12px;font:inherit;font-size:.74rem;font-weight:600;
    color:var(--li-tinta);cursor:pointer}
  .pt__reset:hover{border-color:var(--li-tinta)}
  .pt__lienzo canvas{touch-action:none}
  .pt__puesto:first-of-type{border-top:0;padding-top:0}
  .pt__tipos{display:inline-flex;gap:3px;padding:3px;border-radius:999px;
    background:var(--li-alt);border:1px solid var(--li-linea)}
  .pt__tipo{border:0;background:none;border-radius:999px;padding:7px 15px;
    font:inherit;font-size:.78rem;font-weight:700;color:var(--li-suave);cursor:pointer}
  .pt__tipo--on{background:#fff;color:var(--li-tinta);box-shadow:0 1px 3px rgba(0,0,0,.09)}

  .pt__orden{list-style:none;margin:0;padding:0;display:grid;gap:5px}
  .pt__orden:empty{display:none}
  .pt__fila{display:flex;align-items:center;gap:8px;padding:7px 9px;
    border:1px solid var(--li-linea);border-radius:9px;background:var(--li-alt)}
  .pt__pos{font-size:.74rem;font-weight:800;color:var(--li-acc);min-width:1.2em}
  .pt__quien{flex:1;min-width:0;font-size:.76rem;font-weight:600;line-height:1.25;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pt__quien small{display:block;font-weight:400;color:var(--li-suave);font-size:.69rem}
  .pt__mini{border:1px solid var(--li-linea);background:#fff;border-radius:7px;
    width:24px;height:24px;line-height:1;font-size:.8rem;color:var(--li-tinta);cursor:pointer;padding:0}
  .pt__mini:hover{border-color:var(--li-tinta)}
  .pt__mini[disabled]{opacity:.35;cursor:default}

  .pt__num{font-size:.7rem;font-weight:800;color:var(--li-acc);letter-spacing:.06em;
    cursor:pointer;list-style:none;display:flex;align-items:baseline;gap:8px}
  .pt__num::-webkit-details-marker{display:none}
  /* Flecha propia, que gira al abrir */
  .pt__num::before{content:"▸";font-size:.8rem;transition:transform .15s}
  .pt__puesto[open] > .pt__num::before{transform:rotate(90deg)}
  .pt__num em{font-style:normal;font-weight:600;color:var(--li-suave);
    text-transform:none;letter-spacing:0;font-size:.72rem;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  @media (max-width:900px){.pt{grid-template-columns:1fr}
    .pt__panel,.pt__lienzo{position:static}.pt__lienzo--alto{max-width:620px}}
</style>

<script type="application/json" data-config set:html={datos}></script>

<script>
  import { crearPodio } from "../../scripts/carteles-podio.mjs";

  const C = JSON.parse(document.querySelector("[data-config]").textContent);
  const M = crearPodio(C);
  const { P, cargar, radioFoto, urlFoto, cat, paisDe: pais, banderasDeFicha, sinTildes } = M;

  const canvas = document.querySelector("[data-canvas]");
  const ctx = canvas.getContext("2d");
  const estadoTxt = document.querySelector("[data-estado]");

  const estado = {
    titulo: "SEMIFINAL SOLISTA FEMENINO BACHATA",
    puestos: P.puestos.map((p) => ({ n: p.n, nombre: "", pais: "", foto: null, banderas: [], zoom: 1, dx: 0, dy: 0 })),
    lista: "",
  };

  estado.cartel = "podio";

  // El top 10 junta el podio y la lista de abajo en una sola tabla
  const losDiez = () => [
    ...estado.puestos.map((e, i) => ({
      puesto: i + 1, nombre: e.nombre, pais: e.pais, foto: e.foto, duo: e.duo, equipo: e.equipo,
    })).filter((x) => x.nombre),
    ...restantes.map((x, i) => ({
      puesto: estado.puestos.length + 1 + i,
      nombre: x.nombre, pais: x.pais, foto: x.foto, duo: x.duo, equipo: x.equipo,
    })),
  ];

  const pintar = () => estado.cartel === "top10"
    ? M.pintarTop10(ctx, { titulo: estado.titulo, puestos: losDiez() })
    : M.pintarPodio(ctx, estado);

  document.querySelector("[data-tipos]").addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-cartel]");
    if (!b) return;
    estado.cartel = b.dataset.cartel;
    document.querySelectorAll("[data-cartel]").forEach((x) =>
      x.classList.toggle("pt__tipo--on", x === b));
    pintar();
  });

  /* ── Panel de los tres puestos ── */
  const cont = document.querySelector("[data-puestos]");
  cont.innerHTML = `<p class="pt__t">Podio</p>
    <p class="pt__pista">Arrastra cualquiera de las tres fotos sobre el cartel para moverla
      y usa la rueda del ratón encima para acercarla. El deslizador sirve para afinar.</p>`
    + P.puestos.map((p, i) => `
    <details class="pt__puesto" open>
      <summary class="pt__num">PUESTO ${p.n}<em data-resumen="${i}"></em></summary>
      <label class="pt__campo"><span>Buscar</span><input type="search" data-b="${i}" placeholder="nombre…" /></label>
      <div data-res="${i}"></div>
      <label class="pt__campo"><span>Nombre</span><input type="text" data-nom="${i}" /></label>
      <label class="pt__campo"><span>País</span><input type="text" data-pais="${i}" /></label>
      <label class="pt__campo"><span>Foto</span><input type="file" accept="image/*" data-foto="${i}" /></label>
      <label class="pt__campo"><span>Encuadre <em data-zoomv="${i}">100 %</em></span>
        <input type="range" data-zoom="${i}" min="100" max="300" step="2" value="100" /></label>
      <button type="button" class="pt__reset" data-recentrar="${i}">Volver a centrar</button>
    </details>`).join("");

  let fichas = [];
  const banderasDe = (p) => M.banderasDe(p, fichas);

  cont.addEventListener("input", (ev) => {
    const b = ev.target.closest("[data-b]");
    if (b) {
      const i = +b.dataset.b, q = sinTildes(b.value.trim());
      const caja = cont.querySelector(`[data-res="${i}"]`);
      if (q.length < 2) return (caja.innerHTML = "");
      caja.innerHTML = fichas.filter((p) => sinTildes(p["Nombre / equipo"] + " " + p["País"] + " " + cat(p)).includes(q))
        .slice(0, 6).map((p) => `<button type="button" class="pt__item" data-i="${i}" data-f="${p.__i}">${p["Nombre / equipo"]}
          <small>${cat(p)}${p["País"] ? " · " + p["País"] : ""}${p["Estado foto"] === "Pendiente" ? " · sin foto" : ""}</small></button>`).join("");
      return;
    }
    const n = ev.target.closest("[data-nom]");
    if (n) { estado.puestos[+n.dataset.nom].nombre = n.value; resumir(+n.dataset.nom); return pintar(); }
    const pa = ev.target.closest("[data-pais]");
    if (pa) {
      const e = estado.puestos[+pa.dataset.pais];
      e.pais = pa.value;
      Promise.all(banderasDe(pa.value).map((b) => cargar(b).catch(() => null)))
        .then((bs) => { e.banderas = bs.filter(Boolean); pintar(); });
      return;
    }
  });

  cont.addEventListener("click", async (ev) => {
    const b = ev.target.closest("[data-f]");
    if (!b) return;
    const i = +b.dataset.i, p = fichas[+b.dataset.f], e = estado.puestos[i];
    e.nombre = p["Nombre / equipo"]; e.pais = pais(p);
    e.duo = M.esDuo(p); e.equipo = M.esEquipo(p);
    cont.querySelector(`[data-nom="${i}"]`).value = e.nombre;
    cont.querySelector(`[data-pais="${i}"]`).value = e.pais;
    cont.querySelector(`[data-res="${i}"]`).innerHTML = "";
    resumir(i);
    e.banderas = (await Promise.all(banderasDeFicha(p).map((b) => cargar(b).catch(() => null)))).filter(Boolean);
    // Primero se vacía: si el nuevo no tiene foto, no puede quedarse la del anterior
    e.foto = null;
    recentrar(i);
    e.foto = await M.cargarFoto(p);
    pintar();
  });

  cont.addEventListener("change", async (ev) => {
    const f = ev.target.closest("[data-foto]");
    if (!f || !f.files?.[0]) return;
    const im = new Image(); im.src = URL.createObjectURL(f.files[0]);
    await new Promise((ok) => (im.onload = ok));
    const i = +f.dataset.foto;
    estado.puestos[i].foto = im;
    recentrar(i);
    pintar();
  });

  // Con el puesto plegado, el nombre se ve en la propia cabecera
  const resumir = (i) => {
    const em = cont.querySelector(`[data-resumen="${i}"]`);
    if (!em) return;
    const e = estado.puestos[i];
    em.textContent = e.nombre ? `· ${e.nombre}` : "";
  };

  /* ── Mover y escalar cada foto dentro de su círculo ── */
  const sincronizar = (i) => {
    const z = Math.round(estado.puestos[i].zoom * 100);
    const r = cont.querySelector(`[data-zoom="${i}"]`);
    if (r) r.value = z;
    const v = cont.querySelector(`[data-zoomv="${i}"]`);
    if (v) v.textContent = `${z} %`;
  };
  const recentrar = (i) => {
    const e = estado.puestos[i];
    e.zoom = 1; e.dx = 0; e.dy = 0;
    sincronizar(i);
  };

  cont.addEventListener("input", (ev) => {
    const r = ev.target.closest("[data-zoom]");
    if (!r) return;
    const i = +r.dataset.zoom;
    estado.puestos[i].zoom = +r.value / 100;
    sincronizar(i);
    pintar();
  });

  cont.addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-recentrar]");
    if (!b) return;
    recentrar(+b.dataset.recentrar);
    pintar();
  });

  const aLienzo = (ev) => {
    const r = canvas.getBoundingClientRect();
    return { x: (ev.clientX - r.left) * (P.w / r.width), y: (ev.clientY - r.top) * (P.h / r.height) };
  };
  // Qué círculo hay bajo el puntero. De delante atrás: el del ganador pisa a los otros.
  const puestoEn = (p) => {
    if (estado.cartel !== "podio") return -1;
    for (const i of [0, 1, 2]) {
      const d = P.puestos[i];
      if (estado.puestos[i].foto && Math.hypot(p.x - d.cx, p.y - d.cy) <= radioFoto(d.radio * 2.2)) return i;
    }
    return -1;
  };

  let arrastrando = -1, previo = null;

  canvas.addEventListener("pointermove", (ev) => {
    const p = aLienzo(ev);
    if (arrastrando < 0) { canvas.style.cursor = puestoEn(p) >= 0 ? "grab" : "default"; return; }
    const e = estado.puestos[arrastrando];
    e.dx += p.x - previo.x;
    e.dy += p.y - previo.y;
    previo = p;
    pintar();
  });

  canvas.addEventListener("pointerdown", (ev) => {
    const p = aLienzo(ev), i = puestoEn(p);
    if (i < 0) return;
    arrastrando = i; previo = p;
    canvas.setPointerCapture(ev.pointerId);
    canvas.style.cursor = "grabbing";
  });

  const soltar = (ev) => {
    if (arrastrando < 0) return;
    arrastrando = -1;
    canvas.releasePointerCapture?.(ev.pointerId);
    canvas.style.cursor = "grab";
  };
  canvas.addEventListener("pointerup", soltar);
  canvas.addEventListener("pointercancel", soltar);

  canvas.addEventListener("wheel", (ev) => {
    const p = aLienzo(ev), i = puestoEn(p);
    if (i < 0) return;
    ev.preventDefault();
    const e = estado.puestos[i];
    e.zoom = Math.min(3, Math.max(1, e.zoom * (1 - ev.deltaY * 0.0015)));
    sincronizar(i);
    pintar();
  }, { passive: false });

  document.querySelector("[data-titulo]").addEventListener("input", (e) => { estado.titulo = e.target.value; pintar(); });
  /* ── Del 4 al 10: se eligen buscando, como los puestos del podio ── */
  const L = P.lista;
  const TOPE = L.hasta - L.desde + 1;
  const cajaLista = document.querySelector("[data-b-lista]");
  const resLista = document.querySelector("[data-res-lista]");
  const orden = document.querySelector("[data-orden]");
  const pistaLista = document.querySelector("[data-pista-lista]");
  let restantes = [];

  // El cartel sigue leyendo una línea por puesto; aquí sólo se arma esa cadena
  const sincronizarLista = () => {
    estado.lista = restantes.map((x) => [x.nombre, x.pais].filter(Boolean).join(", ")).join("\n");
  };

  const pintarOrden = () => {
    orden.innerHTML = "";
    restantes.forEach((x, i) => {
      const li = document.createElement("li");
      li.className = "pt__fila";
      li.innerHTML = `<span class="pt__pos">${L.desde + i}</span>
        <span class="pt__quien"></span>
        <button type="button" class="pt__mini" data-sube="${i}" title="Subir" ${i === 0 ? "disabled" : ""}>↑</button>
        <button type="button" class="pt__mini" data-baja="${i}" title="Bajar" ${i === restantes.length - 1 ? "disabled" : ""}>↓</button>
        <button type="button" class="pt__mini" data-fuera="${i}" title="Quitar">×</button>`;
      const quien = li.querySelector(".pt__quien");
      quien.textContent = x.nombre;
      if (x.pais) {
        const s = document.createElement("small");
        s.textContent = x.pais;
        quien.append(s);
      }
      orden.append(li);
    });
    pistaLista.textContent = restantes.length
      ? `${restantes.length} de ${TOPE}. Las flechas cambian el orden.`
      : `Busca y pulsa para ir llenando del ${L.desde} al ${L.hasta}.`;
    cajaLista.disabled = restantes.length >= TOPE;
    sincronizarLista();
  };

  const yaEsta = (p) => restantes.some((x) => x.id === p["ID participante"])
    || estado.puestos.some((e) => e.nombre === p["Nombre / equipo"]);

  cajaLista.addEventListener("input", () => {
    const q = sinTildes(cajaLista.value.trim());
    if (q.length < 2) return (resLista.innerHTML = "");
    resLista.innerHTML = fichas
      .filter((p) => sinTildes(p["Nombre / equipo"] + " " + p["País"] + " " + cat(p)).includes(q))
      .filter((p) => !yaEsta(p))
      .slice(0, 6)
      .map((p) => `<button type="button" class="pt__item" data-fl="${p.__i}">${p["Nombre / equipo"]}
        <small>${cat(p)}${p["País"] ? " · " + p["País"] : ""}</small></button>`).join("");
  });

  resLista.addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-fl]");
    if (!b || restantes.length >= TOPE) return;
    const p = fichas[+b.dataset.fl];
    const ficha = { id: p["ID participante"], nombre: p["Nombre / equipo"], pais: pais(p),
                    duo: M.esDuo(p), equipo: M.esEquipo(p), foto: null };
    restantes.push(ficha);
    cajaLista.value = ""; resLista.innerHTML = "";
    pintarOrden();
    pintar();
    // La foto hace falta para el cartel del top 10; llega cuando llegue
    M.cargarFoto(p).then((im) => { ficha.foto = im; pintar(); });
  });

  orden.addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-sube],[data-baja],[data-fuera]");
    if (!b) return;
    const d = b.dataset;
    if (d.fuera != null) restantes.splice(+d.fuera, 1);
    else {
      const i = +(d.sube ?? d.baja), j = d.sube != null ? i - 1 : i + 1;
      if (j < 0 || j >= restantes.length) return;
      [restantes[i], restantes[j]] = [restantes[j], restantes[i]];
    }
    pintarOrden();
    pintar();
  });

  pintarOrden();

  document.querySelector("[data-descargar]").addEventListener("click", () => {
    canvas.toBlob((b) => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(b);
      a.download = `${M.nombreArchivo(estado.titulo)}-${estado.cartel}.png`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    }, "image/png");
  });

  fetch(C.HOJA.url).then((r) => r.text()).then((t) => {
    fichas = M.leerCSV(t).map((p, i) => ({ ...p, __i: i }));
    estadoTxt.textContent = `${fichas.length} participantes en la hoja.`;
  }).catch((e) => (estadoTxt.textContent = "No se pudo leer la hoja: " + e.message));

  M.precargar().then(pintar).catch(pintar);
</script>
