# Va dentro de la carpeta «subidas», renombrado a .htaccess
#
# No usa php_flag: esa directiva solo existe cuando PHP corre como módulo de
# Apache, y en IONOS va por FastCGI, donde provoca un error 500.
#
# En su lugar se niega el acceso a todo lo ejecutable y se le quita el manejador
# de PHP, así que un script colado aquí no llegaría a ejecutarse.

Options -Indexes

<FilesMatch "\.(php|phps|phar|phtml|php[0-9]|pl|py|cgi|sh|htaccess|ini)$">
  Require all denied
</FilesMatch>

RemoveHandler .php .phtml .phar .php5 .php7 .php8 .cgi .pl .py
RemoveType .php .phtml .phar .php5 .php7 .php8
