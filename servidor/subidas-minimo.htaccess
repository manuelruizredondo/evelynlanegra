# Versión mínima: solo retira el manejador de PHP, que es lo menos probable que
# un hosting compartido prohíba. Si esto también diera error 500, quédate sin
# .htaccess: el receptor ya comprueba extensión y contenido real de cada archivo.

RemoveHandler .php .phtml .phar .php5 .php7 .php8
RemoveType .php .phtml .phar .php5 .php7 .php8
