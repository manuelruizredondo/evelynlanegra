---
// Slider horizontal de vídeos y fotos (scroll-snap + flechas).
// Los vídeos se reproducen solos, en bucle y sin sonido cuando entran en pantalla.
import { slides } from "../data/slider";

interface Props { title?: string; prevLabel?: string; nextLabel?: string; soundLabel?: string; playLabel?: string }
const {
  title = "La Negra en acción",
  prevLabel = "Anterior",
  nextLabel = "Siguiente",
  soundLabel = "Activar o silenciar el sonido",
  playLabel = "Reproducir o pausar el vídeo",
} = Astro.props;
---
{slides.length > 0 && (
  <section class="mslider" aria-label={title}>
    <div class="container">
      <h2 class="ev__title mslider__title">{title}</h2>
    </div>

    <div class="mslider__track" data-ms-track>
      {slides.map((s, i) => (
        <figure class="mslide">
          {s.type === "video" ? (
            <video
              class="mslide__media"
              src={s.src}
              poster={s.poster}
              muted
              loop
              playsinline
              autoplay={i === 0 ? true : undefined}
              preload={i === 0 ? "auto" : "metadata"}
              aria-label={s.alt}
              draggable="false"
              data-ms-video
            ></video>
          ) : (
            <img class="mslide__media" src={s.src} alt={s.alt ?? ""} loading="lazy" decoding="async" draggable="false" />
          )}

          {(s.title || s.subtitle || s.type === "video") && (
            <figcaption class="mslide__cap">
              <div class="mslide__txt">
                {s.title && <span class="mslide__t">{s.title}</span>}
                {s.subtitle && <span class="mslide__s">{s.subtitle}</span>}
              </div>

              {s.type === "video" && (
                <div class="mslide__ctrls">
                  <button class="mslide__btn" type="button" data-ms-play aria-pressed="true" aria-label={playLabel}>
                    <svg class="ico-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path fill="currentColor" d="M8 5v14l11-7z"/>
                    </svg>
                    <svg class="ico-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z"/>
                    </svg>
                  </button>

                  {s.sound && (
                    <button class="mslide__btn" type="button" data-ms-sound aria-pressed="false" aria-label={soundLabel}>
                      <svg class="ico-off" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="currentColor" d="M4 9v6h4l5 5V4L8 9H4z"/>
                        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9.5 L21 14.5 M21 9.5 L16 14.5"/>
                      </svg>
                      <svg class="ico-on" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="currentColor" d="M4 9v6h4l5 5V4L8 9H4zm11.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zm-2.5-7.4v2.06A6.5 6.5 0 0 1 17.5 12a6.5 6.5 0 0 1-4.5 6.17v2.06A8.5 8.5 0 0 0 19.5 12 8.5 8.5 0 0 0 13 4.6z"/>
                      </svg>
                    </button>
                  )}
                </div>
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    <div class="mslider__nav">
      <button class="mslider__btn" data-ms-prev aria-label={prevLabel}>←</button>
      <button class="mslider__btn" data-ms-next aria-label={nextLabel}>→</button>
    </div>
  </section>
)}

<style>
  .mslider{padding:96px 0;border-top:1px solid var(--line)}
  /* Mismo titular que el resto de secciones de la web */
  .mslider__title{font-family:var(--font)!important;font-style:normal!important;font-weight:800;
    font-size:clamp(1.9rem,4.6vw,3.2rem);color:#fff!important;text-align:left;text-transform:uppercase;
    line-height:1;margin:0 0 42px;letter-spacing:-.01em}

  .mslider__track{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;
    padding:4px clamp(20px,calc((100vw - var(--maxw)) / 2 + 20px),400px);
    scroll-padding-inline:clamp(20px,calc((100vw - var(--maxw)) / 2 + 20px),400px);
    scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;
    cursor:grab}
  .mslider__track::-webkit-scrollbar{display:none}
  .mslider__track.is-dragging{cursor:grabbing;scroll-snap-type:none;user-select:none}
  .mslider__track.is-dragging .mslide__media{pointer-events:none}

  .mslide{margin:0;flex:0 0 auto;width:min(78vw,560px);scroll-snap-align:start;position:relative;
    border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:0 16px 40px rgba(0,0,0,.35)}
  .mslide__media{width:100%;aspect-ratio:4/5;object-fit:cover;display:block;background:var(--bg2);
    -webkit-user-drag:none;user-select:none}

  /* Rótulo inferior sobre degradado */
  .mslide__cap{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:flex-end;
    justify-content:space-between;gap:16px;padding:26px 24px 22px;
    background:linear-gradient(to top,rgba(0,0,0,.85) 0%,rgba(0,0,0,.55) 45%,rgba(0,0,0,0) 100%);
    pointer-events:none}
  .mslide__txt{display:flex;flex-direction:column;gap:2px;min-width:0}
  .mslide__t{color:#fff;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;
    font-size:clamp(1.15rem,2.4vw,1.6rem);line-height:1}
  .mslide__s{color:var(--acc);font-weight:800;font-size:clamp(1.15rem,2.4vw,1.6rem);line-height:1}
  .mslide__ctrls{pointer-events:auto;display:flex;gap:10px;flex:0 0 auto}
  .mslide__btn{width:42px;height:42px;border-radius:50%;
    border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.45);color:#fff;cursor:pointer;
    display:grid;place-items:center;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    transition:background .2s,border-color .2s;padding:0}
  .mslide__btn:hover{background:var(--acc);border-color:var(--acc)}
  .mslide__btn svg{grid-area:1/1}
  /* aria-pressed=true significa "reproduciendo" -> se muestra el icono de pausa */
  .mslide__btn .ico-pause,.mslide__btn .ico-on{display:none}
  .mslide__btn[aria-pressed="true"] .ico-pause,.mslide__btn[aria-pressed="true"] .ico-on{display:block}
  .mslide__btn[aria-pressed="true"] .ico-play,.mslide__btn[aria-pressed="true"] .ico-off{display:none}

  .mslider__nav{display:flex;gap:12px;justify-content:center;margin-top:34px}
  .mslider__btn{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:transparent;
    color:#fff;font-size:1.1rem;cursor:pointer;transition:background .2s,border-color .2s}
  .mslider__btn:hover{background:var(--acc);border-color:var(--acc)}

  @media (max-width:600px){
    .mslider{padding:64px 0}
    .mslide{width:84vw}
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-ms-track]");
  if (track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".mslide"));
    // Posición de scroll exacta de cada slide (coincide con los snap points)
    const padLeft = () => parseFloat(getComputedStyle(track).paddingLeft) || 0;
    const targets = () => slides.map((s) => s.offsetLeft - padLeft());
    const currentIndex = () => {
      const x = track.scrollLeft;
      const t = targets();
      let best = 0, d = Infinity;
      t.forEach((p, i) => { const dd = Math.abs(p - x); if (dd < d) { d = dd; best = i; } });
      return best;
    };
    // Animación propia: `behavior:"smooth"` es cancelado por scroll-snap mandatory en varios navegadores.
    let raf = 0;
    let safety: number | undefined;
    const goTo = (i: number) => {
      const t = targets();
      const idx = Math.max(0, Math.min(slides.length - 1, i));
      const from = track.scrollLeft;
      const to = t[idx];
      if (Math.abs(to - from) < 1) return;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      track.style.scrollSnapType = "none";
      const finish = () => { track.style.scrollSnapType = ""; };
      if (reduce) { track.scrollLeft = to; finish(); return; }
      const start = performance.now();
      const dur = 450;
      cancelAnimationFrame(raf);
      window.clearTimeout(safety);
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const e = 1 - Math.pow(1 - p, 3); // easeOutCubic
        track.scrollLeft = from + (to - from) * e;
        if (p < 1) raf = requestAnimationFrame(tick);
        else { window.clearTimeout(safety); finish(); }
      };
      raf = requestAnimationFrame(tick);
      // Si rAF no corre (pestaña en segundo plano), asegura el destino igualmente
      safety = window.setTimeout(() => {
        cancelAnimationFrame(raf);
        track.scrollLeft = to;
        finish();
      }, dur + 120);
    };
    document.querySelector("[data-ms-prev]")?.addEventListener("click", () => goTo(currentIndex() - 1));
    document.querySelector("[data-ms-next]")?.addEventListener("click", () => goTo(currentIndex() + 1));

    // Drag & slide con ratón (en táctil ya funciona el scroll nativo)
    let dragging = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      dragging = true; moved = false;
      startX = e.clientX; startScroll = track.scrollLeft;
      cancelAnimationFrame(raf);
      window.clearTimeout(safety);
      track.classList.add("is-dragging");
    });
    window.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      track.scrollLeft = startScroll - dx;
      e.preventDefault();
    }, { passive: false });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging"); // al soltar, el snap recoloca al slide más cercano
    };
    window.addEventListener("pointerup", endDrag);
    window.addEventListener("pointercancel", endDrag);
    // Evita que un arrastre acabe abriendo/activando el elemento
    track.addEventListener("click", (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    track.addEventListener("dragstart", (e) => e.preventDefault());

    // Botón play/pausa. `paused` marca los vídeos que el usuario ha pausado a mano
    const userPaused = new WeakSet<HTMLVideoElement>();
    track.querySelectorAll<HTMLButtonElement>("[data-ms-play]").forEach((btn) => {
      const v = btn.closest(".mslide")?.querySelector<HTMLVideoElement>("video");
      if (!v) return;
      const sync = () => btn.setAttribute("aria-pressed", String(!v.paused));
      v.addEventListener("play", sync);
      v.addEventListener("pause", sync);
      sync();
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (v.paused) { userPaused.delete(v); v.play().catch(() => {}); }
        else { userPaused.add(v); v.pause(); }
      });
    });

    // Botón de sonido: activa el audio de su vídeo y silencia el resto
    track.querySelectorAll<HTMLButtonElement>("[data-ms-sound]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const v = btn.closest(".mslide")?.querySelector<HTMLVideoElement>("video");
        if (!v) return;
        const turnOn = v.muted;
        track.querySelectorAll<HTMLVideoElement>("video").forEach((other) => { other.muted = true; });
        track.querySelectorAll<HTMLButtonElement>("[data-ms-sound]").forEach((b) => b.setAttribute("aria-pressed", "false"));
        v.muted = !turnOn;
        btn.setAttribute("aria-pressed", String(turnOn));
        if (turnOn) v.play().catch(() => {});
      });
    });

    // Vídeos: play/pausa según visibilidad (en bucle; se silencian al salir de pantalla)
    const videos = Array.from(track.querySelectorAll<HTMLVideoElement>("[data-ms-video]"));
    if (videos.length) {
      const tryPlay = () => {
        const vw = window.innerWidth || document.documentElement.clientWidth;
        videos.forEach((v) => {
          const r = v.getBoundingClientRect();
          const visible = r.width > 0 && r.right > 0 && r.left < vw &&
            r.bottom > 0 && r.top < (window.innerHeight || document.documentElement.clientHeight);
          if (visible) { if (!userPaused.has(v)) v.play().catch(() => {}); }
          else {
            v.pause();
            // Al salir de pantalla, corta el audio y resetea el botón
            if (!v.muted) {
              v.muted = true;
              v.closest(".mslide")?.querySelector("[data-ms-sound]")?.setAttribute("aria-pressed", "false");
            }
          }
        });
      };
      const io = new IntersectionObserver(tryPlay, { threshold: 0.35 });
      videos.forEach((v) => io.observe(v));
      window.addEventListener("scroll", tryPlay, { passive: true });
      track.addEventListener("scroll", tryPlay, { passive: true });
      window.addEventListener("resize", tryPlay, { passive: true });
      setTimeout(tryPlay, 600);
    }
  }
</script>
