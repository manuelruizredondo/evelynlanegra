---
import Base from "../../layouts/Base.astro";
import InternoNav from "../../components/InternoNav.astro";
import { LIENZO, CAJA, LINEAS, REGLA, LOGOS, FIJOS, DESTELLOS, PROGRAMA, PARTICULAS } from "../../data/portadas";
const datos = JSON.stringify({ LIENZO, CAJA, LINEAS, REGLA, LOGOS, FIJOS, DESTELLOS, PROGRAMA, PARTICULAS });
---
<Base title="Creador de portadas · uso interno" description="Generador de portadas del campeonato." noindex={true}>
  <InternoNav actual="/interno/portadas/" />

  <section class="li">
    <div class="li__ancho">
      <p class="li__kicker">Uso interno</p>
      <h1 class="li__h1">Creador de portadas</h1>

      <div class="pt">
        <div class="pt__panel">
          <div class="pt__grupo">
            <p class="pt__t">Textos</p>
            {LINEAS.map((l) => (
              <label class="pt__campo">
                <span>{l.etiqueta}</span>
                <input type="text" data-linea={l.id} value={l.valor} autocomplete="off" />
              </label>
            ))}
            <p class="pt__pista">Cada línea se ajusta sola para ocupar siempre el mismo ancho.</p>
          </div>

          <div class="pt__grupo">
            <p class="pt__t">Logotipo</p>
            <div class="pt__logos">
              {LOGOS.map((lg, i) => (
                <label class="pt__logo">
                  <input type="radio" name="logo" value={lg.src} checked={i === 0} />
                  <img src={lg.src} alt={lg.nombre} />
                  <span>{lg.nombre}</span>
                </label>
              ))}
            </div>
            <label class="pt__campo">
              <span>Tamaño <em data-tam-valor>{FIJOS.logoCaja.lado} px</em></span>
              <input type="range" data-logo-tam
                     min={FIJOS.logoCaja.min} max={FIJOS.logoCaja.max} step="4"
                     value={FIJOS.logoCaja.lado} />
            </label>
            <label class="pt__campo">
              <span>O sube otro</span>
              <input type="file" accept="image/png,image/jpeg,image/webp" data-logo-propio />
            </label>
          </div>

          <div class="pt__grupo">
            <p class="pt__t">Fondo</p>
            <div class="pt__fondos">
              <label class="pt__fondo"><input type="radio" name="fondo" value="imagen" checked /><span>Imagen fija</span></label>
              <label class="pt__fondo"><input type="radio" name="fondo" value="video" /><span>Vídeo</span></label>
            </div>
            <label class="pt__check">
              <input type="checkbox" data-regla checked />
              <span>Línea separadora</span>
            </label>
            <label class="pt__check">
              <input type="checkbox" data-destellos checked />
              <span>Destellos dorados</span>
            </label>
            <label class="pt__campo">
              <span>Partículas</span>
              <select data-particulas>
                <option value="">Ninguna</option>
                {PARTICULAS.map((p, i) => (
                  <option value={p.id} selected={i === 0}>{p.nombre}</option>
                ))}
              </select>
            </label>
            <label class="pt__campo">
              <span>Fuerza de las partículas <em data-fuerza-val>100 %</em></span>
              <input type="range" data-fuerza min="20" max="100" step="5" value="100" />
            </label>
            <p class="pt__pista">El vídeo trae su propio resplandor, que calienta el fondo.
              Bájalo si quieres el mar más azul.</p>
          </div>


          <div class="pt__grupo">
            <p class="pt__t">Del programa</p>
            <label class="pt__campo">
              <span>Formato</span>
              <select data-formato-lote>
                <option value="png">Imagen PNG</option>
                <option value="video">Vídeo</option>
              </select>
            </label>
            <button type="button" class="li__btn" data-finales>Generar las {PROGRAMA.length} portadas</button>
            <p class="pt__pista" data-finales-estado>Las {PROGRAMA.length} del programa, en el orden de la jornada y
              con el escudo que toca. Aparecen abajo, en «Generadas».</p>
            <p class="pt__pista">En vídeo tarda unos cinco minutos, porque graba cada una entera, y
              ocupa cerca de 230 MB en memoria: descárgalas y vacía la lista antes de hacer otra tanda.</p>
          </div>
          <p class="pt__pista" data-aviso hidden></p>

          <div class="pt__acciones">
            <button class="li__btn" type="button" data-descargar>Descargar PNG</button>
            <span class="pt__medida" data-medida>{LIENZO.w} × {LIENZO.h}</span>
          </div>
        </div>

        <div class="pt__lienzo">
          <canvas data-canvas width={LIENZO.w} height={LIENZO.h}></canvas>
        </div>
      </div>

      <section class="gen" data-generados hidden>
        <div class="gen__barra">
          <h2 class="gen__t">Generadas</h2>
          <span class="gen__cuenta" data-cuenta></span>
          <button type="button" class="pt__reset" data-bajar-todo>Descargar todas</button>
          <button type="button" class="pt__reset" data-subir-todo>Subir todas al servidor</button>
          <button type="button" class="pt__reset" data-vaciar>Vaciar</button>
        </div>
        <p class="pt__pista">Se guardan mientras no cierres esta pestaña. Para que duren,
          súbelas al servidor.</p>
        <div class="gen__rejilla" data-rejilla></div>
      </section>

      <section class="gen" data-servidor>
        <div class="gen__barra">
          <h2 class="gen__t">En el servidor</h2>
          <span class="gen__cuenta" data-cuenta-srv></span>
          <div class="gen__filtro" data-filtro>
            <button type="button" class="gen__f gen__f--on" data-ver-tipo="">Todas</button>
            <button type="button" class="gen__f" data-ver-tipo="imagen">Imágenes</button>
            <button type="button" class="gen__f" data-ver-tipo="video">Vídeos</button>
          </div>
          <button type="button" class="pt__reset" data-bajar-srv hidden></button>
          <button type="button" class="pt__reset pt__reset--ojo" data-borrar-srv hidden></button>
          <button type="button" class="pt__reset" data-refrescar>Releer el servidor</button>
        </div>
        <p class="pt__pista">Guardadas en el álbum «portadas». Cada una lleva al lado sus
          ajustes, así que se puede rehacer tal cual.</p>
        <div class="gen__rejilla" data-rejilla-srv></div>
      </section>

      <div class="gen__visor" data-visor hidden>
        <button type="button" class="gen__cerrar" data-cerrar aria-label="Cerrar">×</button>
        <div class="gen__visor-caja" data-visor-caja></div>
      </div>
    </div>
  </section>
</Base>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;800&display=swap" />

<style is:global>
  .li{
    --li-tinta:#15151a; --li-suave:#6d6d76; --li-linea:#e4e4e8;
    --li-fondo:#fff; --li-alt:#f6f6f8; --li-acc:#ce0306;
    background:var(--li-fondo);color:var(--li-tinta);
    padding:calc(var(--header-h) + 8px) 0 70px;min-height:100vh;
  }
  html,body{background:#fff !important}
  .li__ancho{padding-inline:clamp(16px,3vw,44px);max-width:1500px;margin-inline:auto}
  .li__kicker{margin:0 0 6px;color:var(--li-acc);font-size:.7rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.1em}
  .li__h1{color:var(--li-tinta);font-size:clamp(1.7rem,3.5vw,2.4rem);margin:0 0 26px}
  .li__btn{background:var(--li-acc);color:#fff;border:0;border-radius:9px;padding:12px 22px;
    font:inherit;font-weight:700;font-size:.85rem;cursor:pointer}
  .li__btn:hover{filter:brightness(1.1)}

  .nav-toggle span{background:#15151a !important}
  .nav-toggle:hover span{background:#ce0306 !important}
  .lang__btn{color:#15151a !important}
  .site-header.is-scrolled{background:rgba(255,255,255,.9) !important;border-bottom:1px solid #e4e4e8}

  /* Controles a la izquierda, lienzo a la derecha */
  .pt{display:grid;grid-template-columns:minmax(260px,330px) 1fr;gap:clamp(22px,2.5vw,38px);align-items:start}
  .pt__panel{display:grid;gap:22px;position:sticky;top:calc(var(--header-h) + 16px)}
  .pt__grupo{border:1px solid var(--li-linea);border-radius:13px;padding:18px;display:grid;gap:12px}
  .pt__t{margin:0;font-size:.66rem;font-weight:700;text-transform:uppercase;
    letter-spacing:.09em;color:var(--li-suave)}
  .pt__campo{display:grid;gap:5px;font-size:.68rem;font-weight:700;color:var(--li-suave);
    text-transform:uppercase;letter-spacing:.06em}
  .pt__campo input[type=text]{font:inherit;font-weight:600;text-transform:none;letter-spacing:0;
    padding:10px 12px;border:1px solid var(--li-linea);border-radius:8px;background:#fff;
    color:var(--li-tinta);width:100%}
  .pt__campo input[type=text]:focus{outline:none;border-color:var(--li-acc)}
  .pt__campo em{font-style:normal;color:var(--li-tinta);text-transform:none;letter-spacing:0}
  .pt__campo input[type=range]{accent-color:var(--li-acc);width:100%}
  .pt__campo select{border:1px solid var(--li-linea);border-radius:9px;padding:9px 10px;
    font:inherit;font-size:.82rem;font-weight:500;color:var(--li-tinta);background:#fff;
    text-transform:none;letter-spacing:0;width:100%}
  .pt__campo input[type=file]{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;font-size:.78rem}
  .pt__pista{margin:0;color:var(--li-suave);font-size:.74rem;line-height:1.45}

  .pt__logos{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .pt__logo{display:grid;gap:6px;justify-items:center;cursor:pointer;
    border:1px solid var(--li-linea);border-radius:10px;padding:10px 8px;background:var(--li-alt)}
  .pt__logo:has(input:checked){border-color:var(--li-acc);background:#fff}
  .pt__logo input{margin:0}
  .pt__logo img{width:52px;height:52px;object-fit:contain}
  .pt__logo span{font-size:.68rem;text-align:center;line-height:1.3;color:var(--li-suave)}

  .pt__fondos{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .pt__fondo{display:flex;align-items:center;gap:7px;cursor:pointer;font-size:.8rem;
    border:1px solid var(--li-linea);border-radius:9px;padding:9px 11px;background:var(--li-alt)}
  .pt__fondo:has(input:checked){border-color:var(--li-acc);background:#fff;font-weight:600}
  .pt__fondo input{accent-color:var(--li-acc);margin:0}
  .pt__check{display:flex;align-items:center;gap:9px;font-size:.85rem;cursor:pointer}
  .pt__check input{accent-color:var(--li-acc)}
  /* La barra de acciones se queda pegada al fondo de la columna: el panel
     mide una pantalla y media larga y el botón principal quedaba sepultado
     en mitad del formulario. */
  .pt__acciones{display:flex;align-items:center;gap:14px;flex-wrap:wrap;
    position:sticky;bottom:0;z-index:2;margin:0 -4px;padding:12px 4px;
    background:linear-gradient(to top, var(--li-fondo) 72%, rgba(255,255,255,0));
    border-radius:10px}
  @media (max-width:900px){.pt__acciones{position:static;background:none;padding:0}}
  .pt__medida{color:var(--li-suave);font-size:.75rem}
  .pt__reset{background:var(--li-alt);border:1px solid var(--li-linea);border-radius:9px;
    padding:9px 14px;font:inherit;font-size:.76rem;font-weight:600;color:var(--li-tinta);cursor:pointer}
  .pt__reset:hover{border-color:var(--li-tinta)}
  /* Lo que borra se distingue, pero sin gritar */
  .pt__reset--ojo,.gen__a--ojo{color:#a11}
  .pt__reset--ojo:hover,.gen__a--ojo:hover{border-color:#a11;color:#a11}
  .pt__enlace{border:0;background:none;padding:0;font:inherit;font-size:inherit;
    font-weight:700;color:var(--li-acc);cursor:pointer;text-decoration:underline}

  .gen{margin:44px 0 0;border-top:1px solid var(--li-linea);padding-top:24px}
  .gen[hidden]{display:none}
  .gen__barra{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 4px}
  .gen__t{margin:0;font-size:1rem;font-weight:800;color:var(--li-tinta)}
  .gen__cuenta{color:var(--li-suave);font-size:.8rem;margin-right:auto}
  .gen__rejilla{display:grid;gap:18px;margin-top:16px;
    grid-template-columns:repeat(auto-fill,minmax(248px,1fr))}
  .gen__ficha{border:1px solid var(--li-linea);border-radius:13px;overflow:hidden;background:#fff}
  .gen__mini{display:block;width:100%;height:auto;background:#000}
  .gen__pie{padding:10px 12px 12px;display:grid;gap:8px}
  .gen__n{margin:0;font-size:.76rem;font-weight:700;line-height:1.3;word-break:break-word}
  .gen__d{margin:0;color:var(--li-suave);font-size:.71rem}
  .gen__acc{display:flex;gap:7px}
  .gen__a{flex:1;text-align:center;text-decoration:none;background:var(--li-alt);
    border:1px solid var(--li-linea);border-radius:8px;padding:7px 9px;
    font-size:.74rem;font-weight:600;color:var(--li-tinta);cursor:pointer}
  .gen__a:hover{border-color:var(--li-tinta);text-decoration:none}
  .gen__mini{cursor:zoom-in}
  .gen__filtro{display:inline-flex;gap:3px;padding:3px;border-radius:999px;
    background:var(--li-alt);border:1px solid var(--li-linea)}
  .gen__f{border:0;background:none;border-radius:999px;padding:5px 13px;
    font:inherit;font-size:.74rem;font-weight:600;color:var(--li-suave);cursor:pointer}
  .gen__f--on{background:#fff;color:var(--li-tinta);box-shadow:0 1px 3px rgba(0,0,0,.09)}

  .gen__visor{position:fixed;inset:0;z-index:4000;background:rgba(8,8,12,.88);
    display:flex;align-items:center;justify-content:center;padding:26px}
  .gen__visor[hidden]{display:none}
  .gen__visor-caja{display:flex;align-items:center;justify-content:center;max-width:100%;max-height:100%}
  .gen__visor img,.gen__visor video{max-width:min(100%,1100px);max-height:100%;
    border-radius:10px;display:block;background:#000}
  .gen__cerrar{position:fixed;top:18px;right:20px;border:0;border-radius:999px;width:38px;height:38px;
    background:#fff;color:#15151a;font-size:1.1rem;font-weight:700;cursor:pointer;line-height:1}

  .pt__lienzo{border:1px solid var(--li-linea);border-radius:13px;overflow:hidden;background:#000}
  .pt__lienzo canvas{display:block;width:100%;height:auto}
  /* El póster se queda a la vista mientras se recorre el formulario.
     Lienzo de 1920x1080: el ancho sale de multiplicar el alto visible por 16/9. */
  .pt__lienzo{position:sticky;top:calc(var(--header-h) + 16px);
    max-width:min(100%, calc((100vh - var(--header-h) - 46px) * 1.7778));margin-inline:auto}

  @media (max-width:900px){
    .pt{grid-template-columns:1fr}
    .pt__panel,.pt__lienzo{position:static;max-width:none}
  }
</style>

<script type="application/json" data-config set:html={datos}></script>

<script>
  import { bajarEnTanda } from "../../scripts/galeria.mjs";

  const D = JSON.parse(document.querySelector("[data-config]").textContent);
  const canvas = document.querySelector("[data-canvas]");
  const ctx = canvas.getContext("2d");

  const imagenes = {};
  const cargar = (src) => new Promise((ok, mal) => {
    if (imagenes[src]) return ok(imagenes[src]);
    const im = new Image();
    im.crossOrigin = "anonymous";
    im.onload = () => { imagenes[src] = im; ok(im); };
    im.onerror = () => mal(new Error("No se pudo cargar " + src));
    im.src = src;
  });

  /* El estado arranca leyendo el formulario, no las constantes.
     Al recargar, el navegador le devuelve a cada control el valor que tenía
     —y lo hace sin disparar «change»—, así que un estado sacado de las
     constantes podía no tener nada que ver con lo que ponía en pantalla. Pasó
     con las partículas: el desplegable decía «Polvo dorado» y se pintaban
     chispas, porque la elección se restauró sola y nadie se enteró. */
  const uno = (sel) => document.querySelector(sel);
  const estado = {
    textos: Object.fromEntries(D.LINEAS.map((l) =>
      [l.id, uno(`[data-linea="${l.id}"]`)?.value ?? l.valor])),
    logo: uno('input[name="logo"]:checked').value,
    regla: uno("[data-regla]").checked,
    fondo: uno('input[name="fondo"]:checked').value,
    logoTam: +uno("[data-logo-tam]").value,
    destellos: uno("[data-destellos]").checked,
    congelado: false,
    particulas: uno("[data-particulas]").value,
    fuerza: +uno("[data-fuerza]").value / 100,
  };

  // Las dos etiquetas que van al lado de los deslizadores llevan su número
  // escrito en el HTML; si el navegador restauró otro, aquí se ponen al día
  uno("[data-tam-valor]").textContent = `${estado.logoTam} px`;
  uno("[data-fuerza-val]").textContent = `${Math.round(estado.fuerza * 100)} %`;

  const aviso = document.querySelector("[data-aviso]");
  const btn = document.querySelector("[data-descargar]");
  const decir = (txt) => { aviso.textContent = txt || ""; aviso.hidden = !txt; };

  // Vídeo de fondo: en bucle y mudo, se pinta fotograma a fotograma
  const vid = document.createElement("video");
  vid.src = D.FIJOS.fondoVideo;
  vid.muted = true; vid.loop = true; vid.playsInline = true; vid.preload = "auto";
  vid.crossOrigin = "anonymous";
  // Algunos navegadores no reproducen un vídeo que no está en el documento
  vid.style.cssText = "position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;left:-10px";
  document.body.appendChild(vid);

  // Capa de partículas: va por encima del fondo marino, en modo «screen», que
  // deja fuera el negro del vídeo sin tener que recortarlo.
  const chispas = document.createElement("video");
  const fuenteDe = (id) => D.PARTICULAS.find((p) => p.id === id)?.src ?? "";
  chispas.src = fuenteDe(estado.particulas);
  chispas.muted = true; chispas.loop = true; chispas.playsInline = true; chispas.preload = "auto";
  chispas.crossOrigin = "anonymous";
  chispas.style.cssText = vid.style.cssText;
  document.body.appendChild(chispas);

  /* Al dar la vuelta el bucle, el vídeo se queda un fotograma sin entregar
     imagen y la capa desaparece de golpe: como aporta casi todo el brillo, se
     ve como un fogonazo. Se copia cada fotograma bueno a un lienzo aparte y es
     ese el que se pinta, así en el hueco se repite el último en vez de nada.
     requestVideoFrameCallback sólo avisa cuando hay fotograma nuevo de verdad. */
  const capa = document.createElement("canvas");
  capa.width = D.LIENZO.w; capa.height = D.LIENZO.h;
  const capaCtx = capa.getContext("2d");
  let capaLista = false, capaPedida = false;

  const seguirFotogramas = () => {
    if (!chispas.requestVideoFrameCallback || capaPedida) return;
    capaPedida = true;
    const paso = () => {
      capaCtx.drawImage(chispas, 0, 0, capa.width, capa.height);
      capaLista = true;
      chispas.requestVideoFrameCallback(paso);
    };
    chispas.requestVideoFrameCallback(paso);
  };

  let bucle = null;
  const arrancarBucle = () => {
    if (bucle) return;
    const paso = () => { pintar(); bucle = requestAnimationFrame(paso); };
    bucle = requestAnimationFrame(paso);
  };
  const pararBucle = () => { if (bucle) cancelAnimationFrame(bucle); bucle = null; };

  // El lienzo sólo tiene que repintarse solo si hay algo moviéndose
  const revisarBucle = async () => {
    if (estado.particulas) {
      const quiero = fuenteDe(estado.particulas);
      if (!chispas.src.endsWith(quiero)) { chispas.src = quiero; capaLista = false; }
      try { await chispas.play(); } catch { /* bloqueado */ }
      seguirFotogramas();
    } else chispas.pause();
    // Los destellos también laten, así que piden repintado aunque el fondo
    // esté quieto y no haya partículas
    if (estado.fondo === "video" || estado.particulas || estado.destellos) arrancarBucle();
    else { pararBucle(); pintar(); }
  };

  // Cuerpo necesario para que el texto llene exactamente la caja.
  // Se mide a un tamaño de referencia y se escala: así cualquier texto,
  // largo o corto, ocupa siempre el mismo ancho.
  // El texto se dibuja letra a letra: ctx.letterSpacing no mide igual que
  // pinta y en Safari ni existe, así que el ajuste saldría descuadrado.
  const avances = (texto, peso) => {
    const REF = 100;
    ctx.font = `${peso} ${REF}px Inter, sans-serif`;
    return [...texto].map((ch) => ctx.measureText(ch).width / REF);
  };

  // Cuerpo para que la línea llene la caja, con tope en el tamaño del diseño
  // original: el texto puede encoger para caber, pero nunca crece más.
  const medidaLinea = (texto, peso, tracking, anchoDestino, maximo) => {
    const av = avances(texto, peso);
    const porPunto = av.reduce((s, a) => s + a, 0) + tracking * Math.max(0, texto.length - 1);
    if (porPunto <= 0) return { cuerpo: maximo, av, ancho: 0 };
    const cuerpo = Math.min(maximo, anchoDestino / porPunto);
    return { cuerpo, av, ancho: porPunto * cuerpo };
  };

  // Muestreado del dorado de referencia: filo claro arriba, cuerpo cálido,
  // una banda luminosa hacia los dos tercios y ámbar oscuro al pie.
  const oro = (y0, y1) => {
    const g = ctx.createLinearGradient(0, y0, 0, y1);
    g.addColorStop(0.00, "#FFF0CC");
    g.addColorStop(0.09, "#F2CC72");
    g.addColorStop(0.26, "#E0AC46");
    g.addColorStop(0.44, "#CE9630");
    g.addColorStop(0.58, "#E9C97C");
    g.addColorStop(0.73, "#CE9730");
    g.addColorStop(0.89, "#A66B12");
    g.addColorStop(1.00, "#7D3F09");
    return g;
  };

  // Brillo de cuatro puntas, suave
  const destello = (x, y, r, alfa) => {
    if (alfa <= 0.01) return;
    ctx.save();
    ctx.globalCompositeOperation = "lighter";
    const g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, `rgba(255,253,240,${alfa})`);
    g.addColorStop(0.3, `rgba(255,226,150,${alfa * 0.42})`);
    g.addColorStop(1, "rgba(255,200,80,0)");
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();

    ctx.strokeStyle = `rgba(255,250,228,${alfa * 0.9})`;
    ctx.lineCap = "round";
    ctx.lineWidth = Math.max(1, r * 0.10);
    ctx.beginPath(); ctx.moveTo(x - r * 2.5, y); ctx.lineTo(x + r * 2.5, y); ctx.stroke();
    ctx.lineWidth = Math.max(1, r * 0.08);
    ctx.beginPath(); ctx.moveTo(x, y - r * 1.5); ctx.lineTo(x, y + r * 1.5); ctx.stroke();
    ctx.restore();
  };

  const dibujarLinea = (texto, peso, tracking, centroX, l, anchoDestino, dorado, arribaFija) => {
    const { cuerpo, av, ancho } = medidaLinea(texto, peso, tracking, anchoDestino, l.cuerpoMax);
    ctx.font = `${peso} ${cuerpo}px Inter, sans-serif`;
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";

    // «middle» centra la caja tipográfica, no la tinta: en mayúsculas eso
    // sube el texto varios píxeles. Se centra midiendo la tinta de verdad.
    const m = ctx.measureText(texto);
    const arriba = m.actualBoundingBoxAscent ?? cuerpo * 0.72;
    const abajo = m.actualBoundingBoxDescent ?? 0;
    // Si se le pasa dónde empieza la tinta, la línea cuelga de ahí y crece
    // hacia abajo; si no, se centra en su «centroY».
    const base = arribaFija != null ? arribaFija + arriba : l.centroY + (arriba - abajo) / 2;

    const trazar = () => {
      let x = centroX - ancho / 2;
      [...texto].forEach((ch, i) => {
        ctx.fillText(ch, x, base);
        x += av[i] * cuerpo + tracking * cuerpo;
      });
    };

    ctx.fillStyle = dorado ? oro(base - arriba, base + abajo * 0.4) : "#fff";

    // Aureola discreta: lo justo para despegar el oro del fondo
    if (dorado) {
      ctx.save();
      ctx.shadowColor = "rgba(255,183,70,0.30)";
      ctx.shadowBlur = cuerpo * 0.17;
      trazar();
      ctx.restore();
    }

    trazar();

    // Dónde queda la tinta, para colgar de ahí los destellos. «asta» es la
    // punta de arriba por la izquierda de la última letra: en una L es el
    // palito, que es donde tiene que ir el brillo. La esquina de la caja
    // caería en el vacío, a la derecha del pie de la L.
    const anchoUltima = av[av.length - 1] * cuerpo;
    const xUltima = centroX - ancho / 2
      + av.slice(0, -1).reduce((t, a) => t + a, 0) * cuerpo
      + tracking * cuerpo * Math.max(0, texto.length - 1);
    const mu = ctx.measureText(texto[texto.length - 1]);
    const tintaIzq = xUltima - (mu.actualBoundingBoxLeft ?? 0);
    const altoUltima = mu.actualBoundingBoxAscent ?? arriba;

    return {
      derecha: centroX + ancho / 2 - tracking * cuerpo,
      arriba: base - arriba,
      abajo: base + abajo,
      // Centrado en el grosor del asta, que en Inter ronda el 9 % del cuerpo
      asta: { x: tintaIzq + cuerpo * 0.045, y: base - altoUltima, ancho: anchoUltima },
    };
  };

  const pintar = async () => {
    ctx.clearRect(0, 0, D.LIENZO.w, D.LIENZO.h);
    if (estado.fondo === "video" && vid.readyState >= 2) {
      ctx.drawImage(vid, 0, 0, D.LIENZO.w, D.LIENZO.h);
    } else {
      const fondo = await cargar(D.FIJOS.fondo);
      ctx.drawImage(fondo, 0, 0, D.LIENZO.w, D.LIENZO.h);
    }

    // Partículas por encima del fondo y por debajo del logo y los textos, para
    // que no les quiten legibilidad. «screen» hace transparente el negro.
    if (estado.particulas && (capaLista || chispas.readyState >= 2)) {
      ctx.save();
      ctx.globalCompositeOperation = "screen";
      ctx.globalAlpha = estado.fuerza;
      // El lienzo intermedio si lo hay; si el navegador no sabe avisar de los
      // fotogramas, se tira directamente del vídeo.
      ctx.drawImage(capaLista ? capa : chispas, 0, 0, D.LIENZO.w, D.LIENZO.h);
      ctx.restore();
    }

    // Logo de arriba, centrado en su hueco y sin deformarse
    try {
      const lg = imagenes[estado.logo] ?? await cargar(estado.logo);
      const c = D.FIJOS.logoCaja;
      const lado = estado.logoTam;
      const escala = Math.min(lado / lg.width, lado / lg.height);
      const w = lg.width * escala, h = lg.height * escala;
      ctx.drawImage(lg, c.centroX - w / 2, c.centroY - h / 2, w, h);
    } catch { /* sin logo */ }

    // Textos
    const centroX = D.CAJA.x + D.CAJA.ancho / 2;
    let remateLinea1 = null;

    // Las líneas encadenadas arrancan bajo la raya, se dibuje o no
    let borde = D.REGLA.y + D.REGLA.grosor;

    for (const l of D.LINEAS) {
      let t = (estado.textos[l.id] ?? "").trim();
      if (!t) continue;
      if (l.mayusculas) t = t.toUpperCase();
      const caja = dibujarLinea(t, l.peso, l.tracking, centroX, l, D.CAJA.ancho, l.dorado,
                                l.hueco != null ? borde + l.hueco : null);
      if (l.hueco != null) borde = caja.abajo;
      if (l === D.LINEAS[0]) remateLinea1 = caja;
    }

    if (estado.regla) {
      const R = D.REGLA;
      ctx.save();
      ctx.fillStyle = R.dorado ? oro(R.y, R.y + R.grosor) : "#fff";
      if (R.dorado) {
        ctx.shadowColor = "rgba(255,186,66,0.32)";
        ctx.shadowBlur = 11;
      }
      ctx.fillRect(R.x, R.y, R.ancho, R.grosor);
      ctx.restore();
    }

    if (estado.destellos) {
      // En pantalla laten siempre, para que se vea el parpadeo. Al exportar
      // una imagen se congela el reloj, así el PNG sale igual cada vez y no
      // depende de en qué momento del latido se le dé al botón.
      const t = estado.congelado ? 1.15 : performance.now() / 1000;
      for (const d of D.DESTELLOS) {
        let x, y;
        if (d.anclaje === "finTexto") {
          if (!remateLinea1) continue;
          x = remateLinea1.asta.x + (d.dx ?? 0);
          y = remateLinea1.asta.y + (d.dy ?? 0);
        } else {
          x = D.CAJA.x + d.px * D.CAJA.ancho;
          y = D.REGLA.y + D.REGLA.grosor / 2;
        }
        // Onda suave de 0 a 1. Cada destello puede llevar su ritmo y hasta
        // dónde baja; sin nada puesto, late como siempre.
        const onda = 0.5 + 0.5 * Math.sin(t * (d.velocidad ?? 1.25) + d.fase);
        const aMin = d.alfaMin ?? 0.3;
        const rMin = d.radioMin ?? 0.72;
        destello(x, y, d.radio * (rMin + (1 - rMin) * onda), aMin + (1 - aMin) * onda);
      }
    }

    for (const k of ["sello", "hotel"]) {
      try {
        const p = D.FIJOS[k];
        const im = imagenes[p.src] ?? await cargar(p.src);
        ctx.drawImage(im, p.x, p.y, p.ancho, p.alto);
      } catch { /* pieza ausente */ }
    }
  };

  /* ── Controles ── */
  document.querySelectorAll("[data-linea]").forEach((inp) => {
    inp.addEventListener("input", () => {
      estado.textos[inp.dataset.linea] = inp.value;
      pintar();
    });
  });

  document.querySelectorAll('input[name="logo"]').forEach((r) => {
    r.addEventListener("change", () => { estado.logo = r.value; pintar(); });
  });

  document.querySelector("[data-logo-propio]").addEventListener("change", (ev) => {
    const f = ev.target.files?.[0];
    if (!f) return;
    const url = URL.createObjectURL(f);
    estado.logo = url;
    document.querySelectorAll('input[name="logo"]').forEach((r) => (r.checked = false));
    pintar();
  });

  const tam = document.querySelector("[data-logo-tam]");
  tam.addEventListener("input", () => {
    estado.logoTam = +tam.value;
    document.querySelector("[data-tam-valor]").textContent = `${tam.value} px`;
    if (estado.fondo !== "video") pintar();
  });

  document.querySelectorAll('input[name="fondo"]').forEach((r) => {
    r.addEventListener("change", async () => {
      estado.fondo = r.value;
      const esVideo = estado.fondo === "video";
      btn.textContent = esVideo ? "Descargar vídeo" : "Descargar PNG";
      document.querySelector("[data-medida]").textContent =
        esVideo ? `${D.LIENZO.w} × ${D.LIENZO.h} · 15 s` : `${D.LIENZO.w} × ${D.LIENZO.h}`;
      if (esVideo) { try { await vid.play(); } catch { /* el navegador lo bloqueó */ } }
      else vid.pause();
      await revisarBucle();
      decir("");
    });
  });

  document.querySelector("[data-regla]").addEventListener("change", (ev) => {
    estado.regla = ev.target.checked;
    pintar();
  });

  document.querySelector("[data-destellos]").addEventListener("change", (ev) => {
    estado.destellos = ev.target.checked;
    revisarBucle();
  });

  document.querySelector("[data-particulas]").addEventListener("change", (ev) => {
    estado.particulas = ev.target.value;
    revisarBucle();
  });

  document.querySelector("[data-fuerza]").addEventListener("input", (ev) => {
    estado.fuerza = +ev.target.value / 100;
    document.querySelector("[data-fuerza-val]").textContent = `${ev.target.value} %`;
    if (!bucle) pintar();
  });

  // Las tres líneas, para que dos portadas distintas no acaben con el mismo
  // nombre y se pisen al descargarlas en bloque
  const nombreArchivo = () => (D.LINEAS.map((l) => estado.textos[l.id]).filter(Boolean).join(" ") || "portada")
    .toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 80) || "portada";

  const bajar = (blob, nombre) => {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = nombre;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  };

  /* ── Listado de lo que se va generando ──
     Los blobs viven en memoria, así que la lista dura lo que la pestaña. */
  const panelGen = document.querySelector("[data-generados]");
  const rejillaGen = document.querySelector("[data-rejilla]");
  const cuentaGen = document.querySelector("[data-cuenta]");
  const generadas = [];

  const bonito = (b) => b > 1048576 ? (b / 1048576).toFixed(1) + " MB"
                                    : Math.max(1, Math.round(b / 1024)) + " KB";

  const refrescarCuenta = () => {
    const n = generadas.length;
    const bytes = generadas.reduce((t, g) => t + g.blob.size, 0);
    cuentaGen.textContent = n ? `${n} ${n === 1 ? "portada" : "portadas"} · ${bonito(bytes)}` : "";
    panelGen.hidden = n === 0;
  };

  // Miniatura del lienzo tal y como está ahora, para reconocerla de un vistazo
  const miniatura = () => {
    const m = document.createElement("canvas");
    m.width = 496; m.height = Math.round(496 * canvas.height / canvas.width);
    m.getContext("2d").drawImage(canvas, 0, 0, m.width, m.height);
    return m;
  };

  // Si ya hay una con ese nombre en la lista, se numera: ...-2.png, -3.png
  const nombreLibre = (nombre) => {
    if (!generadas.some((g) => g.nombre === nombre)) return nombre;
    const punto = nombre.lastIndexOf(".");
    const raiz = punto < 0 ? nombre : nombre.slice(0, punto);
    const ext = punto < 0 ? "" : nombre.slice(punto);
    let n = 2;
    while (generadas.some((g) => g.nombre === `${raiz}-${n}${ext}`)) n++;
    return `${raiz}-${n}${ext}`;
  };

  // Los ajustes con los que se montó, para poder rehacerla luego
  const ajustesAhora = () => ({
    textos: { ...estado.textos }, logo: estado.logo, logoTam: estado.logoTam,
    fondo: estado.fondo, regla: estado.regla, destellos: estado.destellos,
    particulas: estado.particulas, fuerza: estado.fuerza,
  });

  const registrar = (blob, nombrePedido) => {
    const nombre = nombreLibre(nombrePedido);
    const url = URL.createObjectURL(blob);
    const ficha = { blob, nombre, url, ajustes: ajustesAhora() };
    generadas.unshift(ficha);

    const caja = document.createElement("div");
    caja.className = "gen__ficha";
    const mini = miniatura();
    mini.className = "gen__mini";
    caja.append(mini);

    const pie = document.createElement("div");
    pie.className = "gen__pie";
    pie.innerHTML = `<p class="gen__n"></p><p class="gen__d"></p>
      <div class="gen__acc">
        <a class="gen__a" download href="${url}">Descargar</a>
        <button type="button" class="gen__a" data-subir>Subir</button>
        <button type="button" class="gen__a" data-quitar>Quitar</button>
      </div>`;
    pie.querySelector(".gen__n").textContent = nombre;
    pie.querySelector(".gen__d").textContent =
      `${bonito(blob.size)} · ${new Date().toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit" })}`;
    pie.querySelector("[download]").setAttribute("download", nombre);
    pie.querySelector("[data-subir]").addEventListener("click", async (ev) => {
      const b = ev.currentTarget;
      b.disabled = true; b.textContent = "Subiendo…";
      try {
        await guardarEnServidor(ficha);
        b.textContent = "Guardada";
        await listarServidor();
      } catch (e) {
        b.disabled = false; b.textContent = "Subir";
        decir("No se pudo subir: " + e.message);
      }
    });
    pie.querySelector("[data-quitar]").addEventListener("click", () => {
      URL.revokeObjectURL(url);
      generadas.splice(generadas.indexOf(ficha), 1);
      caja.remove();
      refrescarCuenta();
    });

    caja.append(pie);
    rejillaGen.prepend(caja);
    refrescarCuenta();
  };

  document.querySelector("[data-bajar-todo]").addEventListener("click", async (ev) => {
    const b = ev.currentTarget;
    b.disabled = true;
    for (const g of [...generadas].reverse()) {
      const a = document.createElement("a");
      a.href = g.url; a.download = g.nombre; a.click();
      await new Promise((r) => setTimeout(r, 450));
    }
    b.disabled = false;
  });

  /* ── Servidor de medios: las portadas van al álbum «portadas» ── */
  const ALBUM = "portadas";
  let permiso = null;

  const permisoVigente = async () => {
    const ahora = Math.floor(Date.now() / 1000);
    if (!permiso || Number(permiso.exp) - ahora < 60) {
      const r = await fetch("/.netlify/functions/media-permiso", {
        method: "POST", headers: { "content-type": "application/json" },
        body: "{}", credentials: "same-origin",
      });
      const data = await r.json().catch(() => null);
      if (!data) throw new Error(r.status === 404
        ? "Las funciones de Netlify no están disponibles aquí."
        : `El servidor respondió ${r.status} sin datos.`);
      if (!r.ok) throw new Error(data.error || "Error inesperado");
      permiso = data;
    }
    return permiso;
  };

  const alServidor = async (accion, extra = {}) => {
    const p = await permisoVigente();
    const fd = new FormData();
    fd.append("accion", accion);
    fd.append("album", ALBUM);
    fd.append("exp", p.exp);
    fd.append("sig", p.sig);
    for (const [k, v] of Object.entries(extra)) fd.append(k, v);
    const r = await fetch(p.endpoint, { method: "POST", body: fd });
    const data = await r.json().catch(() => null);
    if (!data) throw new Error(`${p.endpoint} respondió ${r.status} sin datos.`);
    if (!r.ok) throw new Error(data.error || `El servidor respondió ${r.status}`);
    return data;
  };

  // Borra la portada y, si lo tiene, el .json de ajustes de al lado
  const borrarDelServidor = async (a) => {
    await alServidor("borrar", { nombre: a.nombre });
    const raiz = a.nombre.replace(/\.[^.]+$/, "");
    const ajustes = enServidor.find((x) => x.tipo === "ajustes" && x.nombre === `${raiz}.json`);
    if (ajustes) await alServidor("borrar", { nombre: ajustes.nombre }).catch(() => {});
    enServidor = enServidor.filter((x) => x !== a && x !== ajustes);
  };

  // Sube la portada y, al lado, un .json con los ajustes para poder rehacerla
  const guardarEnServidor = async (ficha) => {
    const subida = await alServidor("subir", {
      archivo: new File([ficha.blob], ficha.nombre, { type: ficha.blob.type }),
    });
    const guardado = subida.archivo?.nombre ?? ficha.nombre;
    const raiz = guardado.replace(/\.[^.]+$/, "");
    const ajustes = JSON.stringify({ ...ficha.ajustes, archivo: guardado }, null, 1);
    await alServidor("subir", {
      archivo: new File([ajustes], `${raiz}.json`, { type: "application/json" }),
    });
    return guardado;
  };

  /* ── Visor a pantalla grande, para ver de verdad lo guardado ── */
  const visor = document.querySelector("[data-visor]");
  const visorCaja = document.querySelector("[data-visor-caja]");
  const cerrarVisor = () => { visor.hidden = true; visorCaja.innerHTML = ""; };
  visor.addEventListener("click", (ev) => {
    if (ev.target === visor || ev.target.closest("[data-cerrar]")) cerrarVisor();
  });
  addEventListener("keydown", (ev) => { if (ev.key === "Escape" && !visor.hidden) cerrarVisor(); });

  const abrirVisor = (a) => {
    visorCaja.innerHTML = a.tipo === "video"
      ? `<video src="${a.url}" controls autoplay loop playsinline></video>`
      : `<img src="${a.url}" alt="" />`;
    visor.hidden = false;
  };

  let filtro = "";
  const rejillaSrv = document.querySelector("[data-rejilla-srv]");
  const cuentaSrv = document.querySelector("[data-cuenta-srv]");
  const btnBajarSrv = document.querySelector("[data-bajar-srv]");
  const btnBorrarSrv = document.querySelector("[data-borrar-srv]");
  let enServidor = [];
  // Lo que el filtro deja a la vista, que es lo que se baja en tanda
  let visiblesSrv = [];

  // Pedir al servidor y pintar van por separado: el filtro sólo repinta
  const listarServidor = async () => {
    try {
      const data = await alServidor("listar");
      enServidor = data.archivos ?? [];
    } catch (e) {
      cuentaSrv.textContent = e.message;
      return;
    }
    pintarServidor();
  };

  const pintarServidor = () => {
    const ajustes = new Map(enServidor.filter((a) => a.tipo === "ajustes")
      .map((a) => [a.nombre.replace(/\.json$/, ""), a]));
    const todas = enServidor.filter((a) => a.tipo !== "ajustes");
    const imagenes = todas.filter((a) => a.tipo === "imagen").length;
    const videos = todas.filter((a) => a.tipo === "video").length;
    const piezas = filtro ? todas.filter((a) => a.tipo === filtro) : todas;
    visiblesSrv = piezas;
    btnBorrarSrv.hidden = piezas.length === 0;
    btnBorrarSrv.textContent = `Borrar ${piezas.length === 1
      ? "la que se ve" : `las ${piezas.length} que se ven`}`;
    btnBajarSrv.hidden = piezas.length === 0;
    btnBajarSrv.textContent = `Descargar ${piezas.length === 1
      ? "la que se ve" : `las ${piezas.length} que se ven`}`;

    /* El vacío se explica: «no hay nada» y «el filtro no deja ver nada» son
       dos cosas distintas, y lo que está sólo en «Generadas» todavía no está
       aquí por mucho que se acabe de montar. */
    cuentaSrv.textContent = todas.length
      ? (piezas.length
          ? `${imagenes} ${imagenes === 1 ? "imagen" : "imágenes"} · ${videos} ${videos === 1 ? "vídeo" : "vídeos"}`
          : `Ninguna de las ${todas.length} que hay es de ese tipo.`)
      : (generadas.length
          ? `Vacío. Las ${generadas.length} de arriba están sólo en esta pestaña: súbelas con «Subir todas al servidor».`
          : "Vacío: aquí no hay nada guardado.");

    rejillaSrv.innerHTML = "";
    for (const a of piezas) {
      const raiz = a.nombre.replace(/\.[^.]+$/, "");
      const caja = document.createElement("div");
      caja.className = "gen__ficha";
      caja.innerHTML = `
        ${a.tipo === "video"
          // El «#t=1» obliga al navegador a enseñar un fotograma de verdad;
          // sin él la miniatura de un vídeo sale en negro.
          ? `<video class="gen__mini" src="${a.url}#t=1" preload="metadata" muted loop playsinline></video>`
          : `<img class="gen__mini" src="${a.url}" alt="" loading="lazy" />`}
        <div class="gen__pie">
          <p class="gen__n"></p>
          <p class="gen__d"></p>
          <div class="gen__acc">
            <button type="button" class="gen__a" data-abrir>Ver</button>
            <button type="button" class="gen__a" data-bajar>Descargar</button>
            <button type="button" class="gen__a gen__a--ojo" data-borrar>Borrar</button>
          </div>
        </div>`;
      caja.querySelector(".gen__n").textContent = a.nombre;
      caja.querySelector(".gen__d").textContent =
        `${a.tipo === "video" ? "Vídeo" : "Imagen"} · ${bonito(a.bytes)} · ` +
        new Date(a.fecha).toLocaleDateString("es-ES", { day: "numeric", month: "short" });
      caja.querySelector("[data-abrir]").addEventListener("click", () => abrirVisor(a));
      caja.querySelector(".gen__mini").addEventListener("click", () => abrirVisor(a));
      // El «download» de un enlace no vale aquí: el archivo es de otro
      // dominio y el navegador lo abriría en vez de guardarlo
      caja.querySelector("[data-bajar]").addEventListener("click", async (ev) => {
        const b = ev.currentTarget;
        b.disabled = true; b.textContent = "Bajando…";
        try { await bajarEnTanda([a]); } catch (e) { cuentaSrv.textContent = e.message; }
        b.disabled = false; b.textContent = "Descargar";
      });
      caja.querySelector("[data-borrar]").addEventListener("click", async (ev) => {
        if (!confirm(`¿Borrar «${a.nombre}» del servidor?\n\nNo se puede deshacer.`)) return;
        const b = ev.currentTarget;
        b.disabled = true; b.textContent = "Borrando…";
        try { await borrarDelServidor(a); pintarServidor(); }
        catch (e) { cuentaSrv.textContent = e.message; b.disabled = false; b.textContent = "Borrar"; }
      });

      const conAjustes = ajustes.get(raiz);
      if (conAjustes) {
        const b = document.createElement("button");
        b.type = "button"; b.className = "gen__a"; b.textContent = "Rehacer";
        b.addEventListener("click", async () => {
          b.disabled = true;
          try {
            const r = await fetch(conAjustes.url, { cache: "no-store" });
            aplicarAjustes(await r.json());
            decir(`Cargados los ajustes de ${a.nombre}.`);
          } catch (e) {
            decir("No se pudieron leer los ajustes: " + e.message);
          } finally { b.disabled = false; }
        });
        caja.querySelector(".gen__acc").append(b);
      }
      rejillaSrv.append(caja);
    }
  };

  // Devuelve el creador al estado con el que se montó aquella portada
  const aplicarAjustes = (a) => {
    if (!a || typeof a !== "object") return;
    Object.assign(estado.textos, a.textos ?? {});
    if (a.logo) estado.logo = a.logo;
    if (a.logoTam) estado.logoTam = a.logoTam;
    if (a.fondo) estado.fondo = a.fondo;
    if (typeof a.regla === "boolean") estado.regla = a.regla;
    if (typeof a.destellos === "boolean") estado.destellos = a.destellos;
    if (typeof a.particulas === "string") estado.particulas = a.particulas;
    if (typeof a.fuerza === "number") estado.fuerza = a.fuerza;

    reflejar();
    document.querySelector("[data-regla]").checked = estado.regla;
    document.querySelector("[data-destellos]").checked = estado.destellos;
    document.querySelector("[data-particulas]").value = estado.particulas;
    const rf = document.querySelector("[data-fuerza]");
    rf.value = Math.round(estado.fuerza * 100);
    document.querySelector("[data-fuerza-val]").textContent = `${rf.value} %`;
    document.querySelectorAll('input[name="fondo"]').forEach((rad) => (rad.checked = rad.value === estado.fondo));
    revisarBucle();
  };

  document.querySelector("[data-subir-todo]").addEventListener("click", async (ev) => {
    const b = ev.currentTarget;
    b.disabled = true;
    const original = b.textContent;
    try {
      const pendientes = [...generadas].reverse();
      for (let i = 0; i < pendientes.length; i++) {
        b.textContent = `Subiendo ${i + 1} de ${pendientes.length}…`;
        await guardarEnServidor(pendientes[i]);
      }
      await listarServidor();
      decir(`${pendientes.length} portadas guardadas en el servidor.`);
    } catch (e) {
      decir("No se pudo subir: " + e.message);
    } finally { b.disabled = false; b.textContent = original; }
  });

  document.querySelector("[data-filtro]").addEventListener("click", (ev) => {
    const b = ev.target.closest("[data-ver-tipo]");
    if (!b) return;
    filtro = b.dataset.verTipo;
    document.querySelectorAll("[data-ver-tipo]").forEach((x) =>
      x.classList.toggle("gen__f--on", x === b));
    pintarServidor();
  });

  document.querySelector("[data-refrescar]").addEventListener("click", listarServidor);

  /* Borra en tanda lo que el filtro deja a la vista. Es la forma de limpiar
     una tanda vieja antes de subir la nueva: el servidor nunca pisa archivos,
     así que si no se borra antes quedan las dos, con «-2» al final. */
  btnBorrarSrv.addEventListener("click", async () => {
    const lista = [...visiblesSrv];
    if (!lista.length) return;
    if (!confirm(`¿Borrar del servidor ${lista.length} ${lista.length === 1 ? "archivo" : "archivos"}?\n\n`
      + "Se van también sus ajustes. No se puede deshacer.")) return;
    btnBorrarSrv.disabled = true;
    let hechos = 0;
    try {
      for (const a of lista) {
        btnBorrarSrv.textContent = `Borrando ${hechos + 1} de ${lista.length}`;
        await borrarDelServidor(a);
        hechos++;
      }
    } catch (e) { decir(e.message); }
    btnBorrarSrv.disabled = false;
    pintarServidor();
  });

  /* Baja lo que el filtro deja a la vista: con «Vídeos» puesto, se lleva sólo
     los vídeos. De uno en uno, que una tanda entera pasa de los 200 MB. */
  {
    let bajando = false, parar = false;
    btnBajarSrv.addEventListener("click", async () => {
      if (bajando) { parar = true; btnBajarSrv.textContent = "Parando…"; return; }
      bajando = true; parar = false;
      try {
        await bajarEnTanda([...visiblesSrv], {
          seguir: () => !parar,
          alAvanzar: (hechas, total) => {
            btnBajarSrv.textContent = hechas < total
              ? `Bajando ${hechas + 1} de ${total} · parar`
              : `Listo: ${hechas} de ${total}`;
          },
        });
      } catch (e) { decir(e.message); }
      bajando = false;
      setTimeout(pintarServidor, 1600);
    });
  }

  document.querySelector("[data-vaciar]").addEventListener("click", () => {
    generadas.forEach((g) => URL.revokeObjectURL(g.url));
    generadas.length = 0;
    rejillaGen.innerHTML = "";
    refrescarCuenta();
  });

  // Se prefiere MP4 si el navegador sabe grabarlo; si no, WebM
  const formatoGrabacion = () => {
    for (const f of ["video/mp4;codecs=avc1.42E01E", "video/mp4",
                     "video/webm;codecs=vp9", "video/webm;codecs=vp8", "video/webm"]) {
      if (window.MediaRecorder?.isTypeSupported?.(f)) return f;
    }
    return null;
  };

  // Señal de parada: la levanta el botón y la miran la grabación y el lote,
  // que comprueban entre fotograma y fotograma si tienen que dejarlo.
  let parar = false;

  // Espera troceada, para poder cortar a mitad. Devuelve false si se ha pedido parar.
  const esperarPudiendoParar = async (ms) => {
    const fin = performance.now() + ms;
    while (performance.now() < fin) {
      if (parar) return false;
      await new Promise((ok) => setTimeout(ok, 120));
    }
    return true;
  };

  // Graba una pasada completa del fondo y devuelve el vídeo. Lo usan tanto el
  // botón de descargar como la generación en bloque.
  const grabar = async (alProgresar) => {
    const tipo = formatoGrabacion();
    if (!tipo) throw new Error("Este navegador no sabe grabar vídeo. Prueba con Chrome o Safari.");

    vid.pause(); vid.currentTime = 0;
    if (estado.particulas) { chispas.currentTime = 0; try { await chispas.play(); } catch { /* bloqueado */ } }
    await new Promise((ok) => { vid.onseeked = ok; setTimeout(ok, 600); });

    const stream = canvas.captureStream(30);
    const rec = new MediaRecorder(stream, { mimeType: tipo, videoBitsPerSecond: 8000000 });
    const trozos = [];
    rec.ondataavailable = (e) => { if (e.data.size) trozos.push(e.data); };
    const terminado = new Promise((ok) => (rec.onstop = ok));

    arrancarBucle();
    await vid.play();
    rec.start();

    const dura = (vid.duration || 15) * 1000;
    const t0 = performance.now();
    const reloj = setInterval(
      () => alProgresar?.(Math.min(99, Math.round((performance.now() - t0) / dura * 100))), 300);

    const entera = await esperarPudiendoParar(dura);
    rec.stop();
    clearInterval(reloj);
    await terminado;

    // Si se ha parado a mitad, el trozo grabado no vale: se tira
    if (!entera) return { cortado: true };

    const ext = tipo.startsWith("video/mp4") ? "mp4" : "webm";
    return { blob: new Blob(trozos, { type: tipo }), ext };
  };

  let grabando = false;

  const grabarVideo = async () => {
    // Mientras graba, el mismo botón sirve para dejarlo
    if (grabando) { parar = true; btn.textContent = "Parando…"; return; }
    grabando = true; parar = false;
    try {
      const r = await grabar((pc) => { btn.textContent = `Grabando ${pc}% · parar`; });
      if (r.cortado) { decir("Grabación parada."); return; }
      const comoSeLlama = `${nombreArchivo()}-1920x1080.${r.ext}`;
      bajar(r.blob, comoSeLlama);
      registrar(r.blob, comoSeLlama);
      decir(r.ext === "webm" ? "Guardado en WebM: es lo que graba este navegador. Safari lo da en MP4." : "");
    } catch (e) {
      decir("No se pudo grabar: " + e.message);
    } finally {
      grabando = false; parar = false;
      btn.textContent = "Descargar vídeo";
    }
  };

  btn.addEventListener("click", () => {
    if (estado.fondo === "video") return grabarVideo();
    comoPNG().then((blob) => {
      const comoSeLlama = `${nombreArchivo()}-1920x1080.png`;
      bajar(blob, comoSeLlama);
      registrar(blob, comoSeLlama);
    });
  });

  /* ── Portadas de todas las finales, leídas de la hoja ── */
  const btnFinales = document.querySelector("[data-finales]");
  const avisoFinales = document.querySelector("[data-finales-estado]");

  const logoDe = (disciplina) => {
    const id = (disciplina || "").toLowerCase().includes("salsa") ? "salsa" : "bachata";
    return (D.LOGOS.find((l) => l.id === id) ?? D.LOGOS[0]).src;
  };

  // Deja el formulario como quedó la última portada, para que lo que se ve en
  // pantalla sea de verdad lo último generado.
  const reflejar = () => {
    document.querySelectorAll("[data-linea]").forEach((inp) => {
      inp.value = estado.textos[inp.dataset.linea] ?? "";
    });
    document.querySelectorAll('input[name="logo"]').forEach((rad) => {
      rad.checked = rad.value === estado.logo;
    });
  };

  // Congela el latido, pinta ese fotograma y devuelve el PNG
  const comoPNG = async () => {
    estado.congelado = true;
    await pintar();
    try { return await new Promise((listo) => canvas.toBlob(listo, "image/png")); }
    finally { estado.congelado = false; }
  };

  let montando = false;

  btnFinales.addEventListener("click", async () => {
    if (montando) {
      parar = true;
      btnFinales.textContent = "Parando…";
      avisoFinales.textContent = "Se para al acabar lo que tiene entre manos.";
      return;
    }
    montando = true; parar = false;
    const original = `Generar las ${D.PROGRAMA.length} portadas`;
    try {
      const lista = D.PROGRAMA;
      const enVideo = document.querySelector("[data-formato-lote]").value === "video";
      const fondoAntes = estado.fondo;

      // Para grabar hace falta el fondo en movimiento
      if (enVideo) {
        estado.fondo = "video";
        document.querySelectorAll('input[name="fondo"]').forEach((rad) => (rad.checked = rad.value === "video"));
        try { await vid.play(); } catch { /* bloqueado */ }
        await revisarBucle();
      }

      let hechas = 0;
      for (let i = 0; i < lista.length; i++) {
        if (parar) break;
        const f = lista[i];
        avisoFinales.textContent = `${f.dia} · ${f.fase} ${f.categoria} ${f.disciplina}`;
        estado.textos.linea1 = f.fase;
        estado.textos.linea2 = f.categoria.toUpperCase();
        estado.textos.linea3 = f.disciplina.toUpperCase();
        estado.logo = logoDe(f.disciplina);
        reflejar();
        await pintar();

        if (enVideo) {
          const r = await grabar(
            (pc) => { btnFinales.textContent = `Grabando ${i + 1} de ${lista.length} · ${pc}% · parar`; });
          if (r.cortado) break;
          registrar(r.blob, `${nombreArchivo()}-${D.LIENZO.w}x${D.LIENZO.h}.${r.ext}`);
        } else {
          btnFinales.textContent = `Montando ${i + 1} de ${lista.length} · parar`;
          registrar(await comoPNG(), `${nombreArchivo()}-${D.LIENZO.w}x${D.LIENZO.h}.png`);
        }
        hechas++;
      }

      if (enVideo && fondoAntes !== "video") {
        estado.fondo = fondoAntes;
        document.querySelectorAll('input[name="fondo"]').forEach((rad) => (rad.checked = rad.value === fondoAntes));
        vid.pause();
        await revisarBucle();
      }
      // Un enlace para bajar de un salto: la lista queda a dos pantallas
      avisoFinales.innerHTML = "";
      avisoFinales.append(parar
        ? `Parado, ${hechas} de ${lista.length}. `
        : `${lista.length} portadas montadas. `);
      const ir = document.createElement("button");
      ir.type = "button"; ir.className = "pt__enlace";
      ir.textContent = `Ver las ${parar ? hechas : lista.length} ↓`;
      ir.addEventListener("click", () =>
        panelGen.scrollIntoView({ behavior: "smooth", block: "start" }));
      avisoFinales.append(ir);
    } catch (e) {
      avisoFinales.textContent = "No se pudo: " + e.message;
    } finally {
      montando = false; parar = false;
      btnFinales.textContent = original;
    }
  });

  // Inter tiene que estar cargada antes de medir, o el ajuste saldría mal
  Promise.all([
    document.fonts.load('400 100px Inter'),
    document.fonts.load('800 100px Inter'),
    cargar(D.FIJOS.fondo).catch(() => {}),
    cargar(estado.logo).catch(() => {}),
    cargar(D.FIJOS.sello.src).catch(() => {}),
    cargar(D.FIJOS.hotel.src).catch(() => {}),
  ]).then(pintar).catch(pintar).then(revisarBucle).then(listarServidor);
</script>
