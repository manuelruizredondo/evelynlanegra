---
import Base from "../../layouts/Base.astro";
// Uso interno: no se indexa y /interno/ está bloqueado en robots.txt.
// Los datos no viajan al navegador hasta que el servidor valida la contraseña.
---
<Base title="Lista de espera · uso interno" description="Listado interno de formularios recibidos." noindex={true}>
  <section class="li">
    <div class="li__ancho">
      <p class="li__kicker">Uso interno</p>
      <h1 class="li__h1">Formularios recibidos</h1>

      <form class="li__login" data-login>
        <label>
          <span>Contraseña</span>
          <input type="password" name="clave" autocomplete="current-password" required />
        </label>
        <button class="li__btn" type="submit">Entrar</button>
        <p class="li__error" data-error hidden></p>
      </form>

      <div class="li__panel" data-panel hidden>
        <nav class="li__tabs" data-tabs aria-label="Formularios"></nav>

        <div class="li__barra">
          <label class="li__campo li__campo--ancho">
            <span>Buscar</span>
            <input type="search" data-buscar placeholder="nombre, email, ciudad…" />
          </label>
          <p class="li__contador" data-contador></p>
          <button class="li__btn li__btn--claro" type="button" data-csv>Descargar CSV</button>
        </div>

        <div class="li__cards" data-cards></div>
        <p class="li__vacio" data-vacio hidden>Todavía no hay envíos en este formulario.</p>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Globales a propósito: las fichas las crea el JS y no recibirían
     los estilos limitados de Astro. Todo va prefijado con .li */
  .li{
    --li-tinta:#15151a; --li-suave:#6d6d76; --li-linea:#e4e4e8;
    --li-fondo:#fff; --li-card:#fff; --li-alt:#f6f6f8; --li-acc:#ce0306;
    background:var(--li-fondo);color:var(--li-tinta);
    padding:calc(var(--header-h) + 34px) 0 70px;min-height:100vh;
  }
  .li__ancho{padding-inline:clamp(16px,3vw,44px);max-width:1500px;margin-inline:auto}
  .li__kicker{margin:0 0 6px;color:var(--li-acc);font-size:.7rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.1em}
  .li__h1{color:var(--li-tinta);font-size:clamp(1.7rem,3.5vw,2.4rem);margin:0 0 26px}

  .li__btn{background:var(--li-acc);color:#fff;border:0;border-radius:9px;padding:11px 20px;
    font:inherit;font-weight:700;font-size:.82rem;cursor:pointer}
  .li__btn:hover{filter:brightness(1.1)}
  .li__btn--claro{background:#fff;color:var(--li-tinta);border:1px solid var(--li-linea)}
  .li__btn--claro:hover{border-color:var(--li-tinta);filter:none}

  .li__login{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;max-width:460px}
  .li__login[hidden]{display:none}
  .li__login label{display:flex;flex-direction:column;gap:6px;font-size:.7rem;font-weight:700;
    color:var(--li-suave);text-transform:uppercase;letter-spacing:.06em}
  .li__login input{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;padding:11px 14px;
    border:1px solid var(--li-linea);border-radius:9px;background:#fff;color:var(--li-tinta);min-width:240px}
  .li__login input:focus{outline:none;border-color:var(--li-acc)}
  .li__error{width:100%;margin:6px 0 0;color:var(--li-acc);font-size:.88rem}

  /* Pestañas de formulario: separadas por idioma y ordenadas por actividad */
  .li__tabs{display:flex;flex-wrap:wrap;gap:14px 34px;margin:0 0 22px}
  .li__grupo{min-width:0}
  .li__grupo-t{margin:0 0 9px;font-size:.63rem;font-weight:700;letter-spacing:.1em;
    text-transform:uppercase;color:var(--li-suave);display:flex;align-items:center;gap:7px}
  .li__grupo-t span{background:var(--li-alt);border-radius:999px;padding:1px 7px;
    letter-spacing:0;font-size:.68rem;color:var(--li-tinta)}
  .li__tabs-fila{display:flex;flex-wrap:wrap;gap:8px}
  .li__tab{display:inline-flex;align-items:center;gap:8px;cursor:pointer;
    background:#fff;border:1px solid var(--li-linea);border-radius:999px;
    padding:8px 9px 8px 16px;font:inherit;font-size:.84rem;color:var(--li-tinta);
    transition:border-color .15s,background .15s}
  .li__tab:hover{border-color:var(--li-tinta)}
  .li__tab-num{min-width:22px;height:22px;display:inline-grid;place-items:center;padding:0 6px;
    border-radius:999px;background:var(--li-alt);color:var(--li-suave);
    font-size:.72rem;font-weight:700}
  .li__tab--activo{background:var(--li-acc);border-color:var(--li-acc);color:#fff;font-weight:600}
  .li__tab--activo .li__tab-num{background:rgba(255,255,255,.22);color:#fff}
  /* Los que no han recibido nada, apagados pero accesibles */
  .li__tab--vacio{color:#9a9aa2}
  .li__tab--vacio .li__tab-num{background:transparent;border:1px solid var(--li-linea)}
  .li__tab--vacio.li__tab--activo{color:#fff}

  .li__barra{display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;margin-bottom:24px}
  .li__campo{display:flex;flex-direction:column;gap:6px;font-size:.68rem;font-weight:700;
    color:var(--li-suave);text-transform:uppercase;letter-spacing:.07em}
  .li__campo--ancho{flex:1 1 240px;max-width:380px}
  .li__campo select,.li__campo input{font:inherit;font-weight:400;text-transform:none;letter-spacing:0;
    padding:10px 13px;border:1px solid var(--li-linea);border-radius:9px;background:#fff;
    color:var(--li-tinta);width:100%}
  .li__campo select:focus,.li__campo input:focus{outline:none;border-color:var(--li-acc)}
  .li__contador{margin:0 auto 11px 0;color:var(--li-tinta);font-weight:700;font-size:.88rem}

  /* Una ficha por envío. Sin scroll: lo que no cabe, baja de línea */
  .li__cards{display:grid;gap:18px}
  .li__card{border:1px solid var(--li-linea);border-radius:14px;background:var(--li-card);
    padding:22px 24px;box-shadow:0 1px 2px rgba(0,0,0,.04)}
  .li__cab{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;
    padding-bottom:14px;border-bottom:1px solid var(--li-linea);margin-bottom:16px}
  .li__nombre{margin:0;font-size:1.12rem;font-weight:700;color:var(--li-tinta)}
  .li__ident{min-width:0}
  .li__fecha{margin:0;color:var(--li-suave);font-size:.8rem;white-space:nowrap}
  .li__origen{margin:4px 0 0;font-size:.8rem;overflow-wrap:anywhere}
  .li__origen a{color:var(--li-acc);text-decoration:none}
  .li__origen a:hover{text-decoration:underline}

  /* Datos cortos: caben en una línea si hay sitio; si no, se reparten */
  .li__datos{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px 22px}
  .li__dato{min-width:0}
  .li__k{margin:0 0 3px;color:var(--li-suave);font-size:.63rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.08em}
  .li__v{margin:0;color:var(--li-tinta);font-size:.92rem;line-height:1.45;overflow-wrap:anywhere}
  .li__v--vacio{color:#b5b5bc}
  .li__v a{color:var(--li-acc);text-decoration:none}
  .li__v a:hover{text-decoration:underline}

  /* Lo que escribió: a lo ancho de la ficha */
  .li__textos{margin-top:18px;padding-top:16px;border-top:1px solid var(--li-linea);display:grid;gap:14px}
  .li__texto{background:var(--li-alt);border-radius:10px;padding:14px 16px}
  .li__texto .li__v{white-space:pre-line;max-width:95ch}

  .li__vacio{color:var(--li-suave);margin-top:18px}

  @media (max-width:560px){
    .li__card{padding:18px 16px}
    .li__datos{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
  }
</style>

<script>
  const $ = (s) => document.querySelector(s);
  const login = $("[data-login]"), panel = $("[data-panel]"), error = $("[data-error]");
  const tabs = $("[data-tabs]"), buscar = $("[data-buscar]");
  const cards = $("[data-cards]"), contador = $("[data-contador]");
  const vacio = $("[data-vacio]"), btnCsv = $("[data-csv]");

  // La contraseña vive solo en memoria: al recargar se vuelve a pedir.
  let clave = "";
  let envios = [];
  let columnas = [];
  let listaForms = [];
  let actual = "";

  const OCULTAS = ["bot-field", "form-name"];
  // Texto libre: ocupa el ancho de la ficha en lugar de una celda
  const TEXTOS = ["expectativas", "mensaje", "como-conociste"];
  // Ya salen en la cabecera de la ficha
  const EN_CABECERA = ["nombre", "apellidos", "referrer"];

  // El user agent en crudo es ilegible. Interesa de dónde vino y con qué aparato.
  const desde = (ua) => {
    if (!ua) return "";
    const s = String(ua);
    const app =
      /Instagram/i.test(s) ? "Instagram" :
      /FBAN|FBAV|FB_IAB/i.test(s) ? "Facebook" :
      /TikTok|BytedanceWebview/i.test(s) ? "TikTok" :
      /WhatsApp/i.test(s) ? "WhatsApp" :
      /Edg\//.test(s) ? "Edge" :
      /OPR\/|Opera/.test(s) ? "Opera" :
      /SamsungBrowser/.test(s) ? "Samsung Internet" :
      /Firefox/.test(s) ? "Firefox" :
      /Chrome|CriOS/.test(s) ? "Chrome" :
      /Safari/.test(s) ? "Safari" : "Navegador";
    const aparato =
      /iPhone/.test(s) ? "iPhone" :
      /iPad/.test(s) ? "iPad" :
      /Android/.test(s) ? "Android" :
      /Macintosh|Mac OS X/.test(s) ? "Mac" :
      /Windows/.test(s) ? "Windows" :
      /Linux/.test(s) ? "Linux" : "";
    return aparato ? `${app} · ${aparato}` : app;
  };

  // De dónde salió el formulario: la ruta si es de la web, el dominio si viene de fuera
  const origen = (url) => {
    const bruto = String(url ?? "").trim();
    if (!bruto) return null;
    try {
      const u = new URL(bruto);
      const propio = u.hostname.replace(/^www\./, "") === location.hostname.replace(/^www\./, "");
      return { href: bruto, texto: propio ? u.pathname : u.hostname.replace(/^www\./, "") + u.pathname };
    } catch { return { href: null, texto: bruto }; }
  };

  // Los nombres internos no dicen nada a quien consulta esto
  const NOMBRES = {
    "lista-espera-online": "Lista de espera · curso online",
    "contacto-formacion": "Máster de profesorado",
    "contacto-presencial": "Clases presenciales",
    "logotipos": "Logotipos",
    "newsletter": "Newsletter",
  };
  const nombreForm = (n) => {
    const it = n.endsWith("-it");
    const base = it ? n.slice(0, -3) : n;
    return { titulo: NOMBRES[base] ?? base.replace(/-/g, " "), idioma: it ? "IT" : "ES" };
  };

  const ETIQUETAS = {
    "nombre-artistico": "Nombre artístico", "otras-disciplinas": "Otras disciplinas",
    "como-conociste": "Cómo nos conoció", "consentimiento": "Acepta privacidad",
    "expectativas": "Qué espera de la formación", "pais": "País",
    "experiencia": "Años de experiencia", "telefono": "Teléfono",
    "user_agent": "Llegó desde", "referrer": "Página de origen", "ip": "IP",
  };
  const etiqueta = (k) => ETIQUETAS[k] ?? k.charAt(0).toUpperCase() + k.slice(1);

  const escapar = (s) => String(s).replace(/[<>&"]/g, (m) =>
    ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" }[m]));

  const pedir = async (formulario) => {
    const r = await fetch("/.netlify/functions/lista-espera", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ clave, formulario }),
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error || "Error inesperado");
    return data;
  };

  const fecha = (iso) => {
    try {
      return new Date(iso).toLocaleString("es-ES",
        { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
    } catch { return iso; }
  };

  const valor = (campo, bruto) => {
    const v = Array.isArray(bruto) ? bruto.join(", ") : (bruto ?? "");
    const texto = String(v).trim();
    if (!texto) return `<p class="li__v li__v--vacio">—</p>`;

    if (campo === "email")
      return `<p class="li__v"><a href="mailto:${escapar(texto)}">${escapar(texto)}</a></p>`;
    if (campo === "telefono") {
      const limpio = texto.replace(/[^+\d]/g, "").replace(/^\+/, "");
      return `<p class="li__v"><a href="https://wa.me/${limpio}" target="_blank" rel="noopener">${escapar(texto)}</a></p>`;
    }
    if (campo === "user_agent") {
      const corto = desde(texto);
      return `<p class="li__v" title="${escapar(texto)}">${escapar(corto)}</p>`;
    }
    if (campo === "instagram") {
      const usuario = texto.replace(/^@/, "");
      return `<p class="li__v"><a href="https://instagram.com/${escapar(usuario)}" target="_blank" rel="noopener">@${escapar(usuario)}</a></p>`;
    }
    return `<p class="li__v">${escapar(texto)}</p>`;
  };

  const pintarTabs = () => {
    const grupo = (idioma) => listaForms
      .filter((f) => nombreForm(f.name).idioma === idioma)
      .sort((a, b) => (b.count - a.count) || a.name.localeCompare(b.name));

    const pastilla = (f) => {
      const clases = ["li__tab"];
      if (f.name === actual) clases.push("li__tab--activo");
      if (!f.count) clases.push("li__tab--vacio");
      return `<button type="button" class="${clases.join(" ")}" data-form="${f.name}">
        <span class="li__tab-txt">${nombreForm(f.name).titulo}</span>
        <span class="li__tab-num">${f.count}</span>
      </button>`;
    };

    const bloque = (idioma, titulo) => {
      const lista = grupo(idioma);
      if (!lista.length) return "";
      const total = lista.reduce((s, f) => s + f.count, 0);
      return `<div class="li__grupo">
        <p class="li__grupo-t">${titulo} <span>${total}</span></p>
        <div class="li__tabs-fila">${lista.map(pastilla).join("")}</div>
      </div>`;
    };

    tabs.innerHTML = bloque("ES", "Español") + bloque("IT", "Italiano");
  };

  const pintar = () => {
    const q = buscar.value.trim().toLowerCase();
    const filas = q
      ? envios.filter((e) => JSON.stringify(e.datos).toLowerCase().includes(q))
      : envios;

    contador.textContent = filas.length === envios.length
      ? `${envios.length} ${envios.length === 1 ? "envío" : "envíos"}`
      : `${filas.length} de ${envios.length}`;

    const cortos = columnas.filter((c) => !TEXTOS.includes(c) && !EN_CABECERA.includes(c));
    const largos = columnas.filter((c) => TEXTOS.includes(c));

    cards.innerHTML = filas.map((e) => {
      const d = e.datos;
      const nombre = [d.nombre, d.apellidos].filter(Boolean).join(" ").trim() || "Sin nombre";

      const datos = cortos.map((c) =>
        `<div class="li__dato"><p class="li__k">${etiqueta(c)}</p>${valor(c, d[c])}</div>`).join("");

      const textos = largos
        .map((c) => [c, String(d[c] ?? "").trim()])
        .filter(([, v]) => v)
        .map(([c, v]) =>
          `<div class="li__texto"><p class="li__k">${etiqueta(c)}</p><p class="li__v">${escapar(v)}</p></div>`)
        .join("");

      const ref = origen(d.referrer);
      const linea = ref
        ? `<p class="li__origen">${ref.href
            ? `<a href="${escapar(ref.href)}" target="_blank" rel="noopener">${escapar(ref.texto)}</a>`
            : escapar(ref.texto)}</p>`
        : "";

      return `<article class="li__card">
        <header class="li__cab">
          <div class="li__ident">
            <h2 class="li__nombre">${escapar(nombre)}</h2>
            ${linea}
          </div>
          <p class="li__fecha">${fecha(e.fecha)}</p>
        </header>
        <div class="li__datos">${datos}</div>
        ${textos ? `<div class="li__textos">${textos}</div>` : ""}
      </article>`;
    }).join("");

    vacio.hidden = envios.length > 0;
  };

  const cargar = async (formulario) => {
    const data = await pedir(formulario);

    actual = data.actual ?? actual;
    if (data.formularios) listaForms = data.formularios;
    pintarTabs();

    envios = data.envios ?? [];
    const vistas = new Set();
    envios.forEach((e) => Object.keys(e.datos).forEach((k) => { if (!OCULTAS.includes(k)) vistas.add(k); }));
    columnas = [...vistas];
    pintar();
  };

  login.addEventListener("submit", async (ev) => {
    ev.preventDefault();
    error.hidden = true;
    clave = login.clave.value;
    const btn = login.querySelector("button");
    btn.disabled = true; btn.textContent = "Comprobando…";
    try {
      await cargar();
      login.hidden = true;
      panel.hidden = false;
    } catch (e) {
      clave = "";
      error.textContent = e.message;
      error.hidden = false;
    } finally {
      btn.disabled = false; btn.textContent = "Entrar";
    }
  });

  tabs.addEventListener("click", (ev) => {
    const btn = ev.target.closest("[data-form]");
    if (!btn || btn.dataset.form === actual) return;
    buscar.value = "";
    cargar(btn.dataset.form).catch((e) => alert(e.message));
  });
  buscar.addEventListener("input", pintar);

  btnCsv.addEventListener("click", () => {
    const esc = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
    const cab = ["fecha", ...columnas].map(esc).join(",");
    const filas = envios.map((e) =>
      [e.fecha, ...columnas.map((c) => (Array.isArray(e.datos[c]) ? e.datos[c].join(" | ") : e.datos[c]))]
        .map(esc).join(","));
    const csv = "﻿" + [cab, ...filas].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" }));
    a.download = `${actual || "formulario"}-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  });
</script>
