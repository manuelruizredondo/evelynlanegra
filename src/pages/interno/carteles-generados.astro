---
import Base from "../../layouts/Base.astro";
import InternoNav from "../../components/InternoNav.astro";
import SubNavCarteles from "../../components/SubNavCarteles.astro";
import { CARTEL, PODIO, TOP10, HOJA, FASES } from "../../data/carteles";
import { BANDERAS, ES_EN } from "../../data/banderas";
const datos = JSON.stringify({ aro: CARTEL.aro, PODIO, TOP10, HOJA, FASES, BANDERAS, ES_EN });
---
<Base title="Carteles generados · uso interno" description="Genera los carteles de podio y top 10 leyendo la hoja." noindex={true}>
  <InternoNav actual="/interno/carteles/" />

  <section class="li">
    <div class="li__ancho">
      <p class="li__kicker">Uso interno</p>
      <h1 class="li__h1">Carteles</h1>
      <SubNavCarteles actual="/interno/carteles-generados/" />

      <div class="ge__barra">
        <button class="li__btn" type="button" data-generar disabled>Generar carteles</button>
        <button type="button" class="pt__reset" data-ensayo>Probar con puestos de ejemplo</button>
        <label class="ge__check"><input type="checkbox" data-con-semis /> Incluir semifinales</label>
        <button type="button" class="pt__reset" data-bajar-todo hidden>Descargar todos</button>
        <button type="button" class="pt__reset" data-subir-todo hidden>Guardar en el servidor</button>
        <span class="ge__estado" data-estado>Leyendo la hoja…</span>
      </div>

      <div data-salida></div>

      <section class="ge__guardados" data-guardados>
        <div class="ge__barra">
          <h2 class="ge__h2b">Guardados en el servidor</h2>
          <span class="ge__estado" data-cuenta-srv></span>
          <div class="ge__filtro" data-filtro>
            <button type="button" class="ge__f ge__f--on" data-ver-tipo="">Todos</button>
            <button type="button" class="ge__f" data-ver-tipo="imagen">Imágenes</button>
            <button type="button" class="ge__f" data-ver-tipo="video">Vídeos</button>
          </div>
          <button type="button" class="pt__reset" data-bajar-srv hidden></button>
          <button type="button" class="pt__reset pt__reset--ojo" data-borrar-srv hidden></button>
          <button type="button" class="pt__reset" data-refrescar>Releer el servidor</button>
        </div>
        <div class="ge__rejilla" data-rejilla-srv></div>
      </section>
    </div>
  </section>
</Base>

<script type="application/json" data-config set:html={datos}></script>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap" />

<style is:global>
  .li{--li-tinta:#15151a;--li-suave:#6d6d76;--li-linea:#e4e4e8;--li-fondo:#fff;--li-alt:#f6f6f8;--li-acc:#ce0306;
    background:var(--li-fondo);color:var(--li-tinta);padding:calc(var(--header-h) + 8px) 0 70px;min-height:100vh}
  html,body{background:#fff !important}
  .li__ancho{max-width:var(--maxw);margin-inline:auto;padding-inline:clamp(18px,4vw,34px)}
  .li__kicker{margin:0 0 6px;font-size:.72rem;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--li-acc)}
  .li__h1{color:var(--li-tinta);margin:0 0 18px;font-size:clamp(1.7rem,3.5vw,2.4rem);line-height:1.05}
  .li__btn{border:0;border-radius:10px;padding:11px 20px;background:var(--li-acc);color:#fff;
    font:inherit;font-size:.85rem;font-weight:700;cursor:pointer}
  .li__btn[disabled]{background:#c9c9d0;cursor:default}
  .pt__reset{background:var(--li-alt);border:1px solid var(--li-linea);border-radius:9px;
    padding:10px 15px;font:inherit;font-size:.78rem;font-weight:600;color:var(--li-tinta);cursor:pointer}
  .pt__reset:hover{border-color:var(--li-tinta)}
  /* Lo que borra se distingue, pero sin gritar */
  .pt__reset--ojo,.ge__a--ojo{color:#a11}
  .pt__reset--ojo:hover,.ge__a--ojo:hover{border-color:#a11;color:#a11}
  .pt__reset[hidden]{display:none}

  .ge__barra{display:flex;align-items:center;gap:13px;flex-wrap:wrap;margin:0 0 26px}
  .ge__estado{color:var(--li-suave);font-size:.82rem}
  .ge__check{display:inline-flex;align-items:center;gap:7px;color:var(--li-suave);
    font-size:.8rem;font-weight:600;cursor:pointer}
  .ge__check input{accent-color:var(--li-acc)}
  .ge__enlace{border:0;background:none;padding:0;font:inherit;font-size:inherit;
    font-weight:700;color:var(--li-acc);cursor:pointer;text-decoration:underline}

  .ge__rejilla{display:grid;gap:22px;
    grid-template-columns:repeat(auto-fill,minmax(236px,1fr))}
  .ge__disc{display:block;margin:0 0 38px}
  .ge__h2{margin:0 0 4px;font-size:1.15rem;font-weight:800;letter-spacing:.02em;
    color:var(--li-tinta);padding-bottom:9px;border-bottom:2px solid var(--li-tinta)}
  .ge__cat{margin:20px 0 0}
  .ge__h3{margin:0 0 12px;font-size:.76rem;font-weight:800;letter-spacing:.12em;
    text-transform:uppercase;color:var(--li-suave)}
  .ge__ficha{border:1px solid var(--li-linea);border-radius:14px;overflow:hidden;background:#fff;
    display:flex;flex-direction:column}
  .ge__lienzo{display:block;width:100%;height:auto;background:#06202b;cursor:zoom-in}
  .ge__pie{padding:11px 13px 13px;display:grid;gap:8px}
  .ge__t{margin:0;font-size:.79rem;font-weight:700;line-height:1.3}
  .ge__sub{margin:0;color:var(--li-suave);font-size:.72rem}
  .ge__acciones{display:flex;gap:7px}
  .ge__a{flex:1;text-align:center;text-decoration:none;background:var(--li-alt);
    border:1px solid var(--li-linea);border-radius:8px;padding:7px 9px;
    font-size:.74rem;font-weight:600;color:var(--li-tinta)}
  .ge__a:hover{border-color:var(--li-tinta);text-decoration:none}

  .ge__visor{position:fixed;inset:0;z-index:4000;background:rgba(8,8,12,.86);
    display:flex;align-items:center;justify-content:center;padding:26px}
  .ge__visor[hidden]{display:none}
  .ge__visor-caja{display:flex;align-items:center;justify-content:center;max-width:100%;max-height:100%}
  .ge__visor img,.ge__visor video{max-width:min(100%,900px);max-height:100%;
    border-radius:10px;display:block;background:#000}
  .ge__lienzo{cursor:zoom-in}
  .ge__guardados{margin:46px 0 0;border-top:1px solid var(--li-linea);padding-top:24px}
  .ge__barra{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 16px}
  .ge__h2b{margin:0;font-size:1rem;font-weight:800;color:var(--li-tinta)}
  .ge__filtro{display:inline-flex;gap:3px;padding:3px;border-radius:999px;
    background:var(--li-alt);border:1px solid var(--li-linea);margin-left:auto}
  .ge__f{border:0;background:none;border-radius:999px;padding:5px 13px;
    font:inherit;font-size:.74rem;font-weight:600;color:var(--li-suave);cursor:pointer}
  .ge__f--on{background:#fff;color:var(--li-tinta);box-shadow:0 1px 3px rgba(0,0,0,.09)}
  .ge__cerrar{position:fixed;top:18px;right:20px;border:0;border-radius:999px;width:38px;height:38px;
    background:#fff;color:#15151a;font-size:1.1rem;font-weight:700;cursor:pointer;line-height:1}
</style>

<div class="ge__visor" data-visor hidden>
  <button type="button" class="ge__cerrar" data-cerrar aria-label="Cerrar">×</button>
  <div class="ge__visor-caja" data-visor-caja></div>
</div>

<script>
  import { crearPodio } from "../../scripts/carteles-podio.mjs";
  import { crearGaleria } from "../../scripts/galeria.mjs";

  const C = JSON.parse(document.querySelector("[data-config]").textContent);
  const M = crearPodio(C);
  const { P, T } = M;

  const estadoTxt = document.querySelector("[data-estado]");
  const salida = document.querySelector("[data-salida]");
  const btnGenerar = document.querySelector("[data-generar]");
  const btnTodo = document.querySelector("[data-bajar-todo]");

  let fichas = [];
  let hechos = [];
  let ensayo = false;

  /* Sólo se montan carteles de ganadores de las fases que deciden algo. Una
     eliminatoria o una pre-eliminatoria no tiene podio que enseñar. */
  const fasesBuenas = () =>
    document.querySelector("[data-con-semis]").checked ? ["Final", "Semifinal"] : ["Final"];
  const esDeFaseBuena = (p) => fasesBuenas().includes(p["Fase"]);

  // Las pruebas de la hoja, ya filtradas por fase
  const pruebasBuenas = () => {
    const m = M.pruebas(fichas);
    for (const [k, v] of [...m]) if (!esDeFaseBuena(v[0])) m.delete(k);
    return m;
  };

  const btnSubir = document.querySelector("[data-subir-todo]");

  /* ── Lo guardado en el servidor, en su propio álbum ── */
  const galeria = crearGaleria({
    album: "carteles",
    nodos: {
      rejilla: document.querySelector("[data-rejilla-srv]"),
      cuenta: document.querySelector("[data-cuenta-srv]"),
      filtro: document.querySelector("[data-filtro]"),
      bajarTodo: document.querySelector("[data-bajar-srv]"),
      borrarTodo: document.querySelector("[data-borrar-srv]"),
      visor: document.querySelector("[data-visor]"),
      visorCaja: document.querySelector("[data-visor-caja]"),
    },
    // Rehacer: se vuelve a montar esa misma prueba con lo que diga la hoja hoy
    alRehacer: async (ajustes) => {
      const m = pruebasBuenas();
      const clave = [ajustes.disciplina, ajustes.categoria, ajustes.fase].join("\u0001");
      const lista = m.get(clave);
      if (!lista?.length) {
        estadoTxt.textContent = `«${M.cat({ Disciplina: ajustes.disciplina, "Categoría": ajustes.categoria, Fase: ajustes.fase })}» ya no tiene puestos en la hoja.`;
        return;
      }
      estadoTxt.textContent = `Rehaciendo ${M.cat(lista[0])}…`;
      const salidos = await montarPrueba(lista);
      hechos.push(...salidos);
      btnTodo.hidden = false; btnSubir.hidden = false;
      estadoTxt.textContent = `${M.cat(lista[0])}, rehecho con lo que dice la hoja hoy. Está arriba, sin guardar todavía.`;
    },
  });

  /* ── Un lienzo de trabajo, fuera de pantalla ── */
  const taller = document.createElement("canvas");
  taller.width = P.w; taller.height = P.h;
  const tctx = taller.getContext("2d");

  const aBlob = () => new Promise((ok) => taller.toBlob(ok, "image/png"));

  // Miniatura visible: el PNG a tamaño completo en la rejilla sería un derroche
  const miniatura = () => {
    const m = document.createElement("canvas");
    m.width = 472; m.height = Math.round(472 * P.h / P.w);
    m.getContext("2d").drawImage(taller, 0, 0, m.width, m.height);
    return m;
  };

  /* ── Montar el estado de una prueba a partir de sus fichas ── */
  const montar = async (lista) => {
    const titulo = M.cat(lista[0]);

    const puestos = await Promise.all(P.puestos.map(async (d) => {
      const p = lista.find((x) => x.__puesto === d.n);
      if (!p) return { n: d.n, nombre: "", pais: "", foto: null, banderas: [], zoom: 1, dx: 0, dy: 0 };
      const banderas = (await Promise.all(M.banderasDeFicha(p).map((b) => M.cargar(b).catch(() => null)))).filter(Boolean);
      const foto = await M.cargarFoto(p);
      return { n: d.n, nombre: p["Nombre / equipo"], pais: M.paisDe(p), foto, banderas,
               duo: M.esDuo(p), equipo: M.esEquipo(p), zoom: 1, dx: 0, dy: 0 };
    }));

    const diez = await Promise.all(lista.filter((x) => x.__puesto <= T.filas.cuantas).map(async (p) => {
      return {
        puesto: p.__puesto,
        nombre: p["Nombre / equipo"],
        pais: M.paisDe(p),
        duo: M.esDuo(p),
        equipo: M.esEquipo(p),
        foto: await M.cargarFoto(p),
      };
    }));

    const sinFoto = puestos.filter((e) => e.nombre && !e.foto).length;
    return { titulo, podio: { titulo, puestos }, top: { titulo, puestos: diez }, sinFoto, cuantos: lista.length };
  };

  /* ── Orden de salida: salsa antes que bachata, y dentro por tipo ── */
  const ORDEN_DISC = ["salsa", "bachata"];
  const ORDEN_CAT = ["parejas", "duos", "duo-femenino", "duo-masculino", "equipos",
                     "solista-femenino", "solista-masculino"];
  const ORDEN_FASE = ["final", "semifinal", "eliminatoria", "preeliminatoria"];
  // Lo que no esté en la lista va detrás, en orden alfabético
  const puesto = (lista, v) => {
    const i = lista.indexOf(M.sinAcentos(v));
    return i < 0 ? lista.length : i;
  };
  const compara = (a, b) => (a > b ? 1 : a < b ? -1 : 0);

  const ordenadas = (m) => [...m.entries()].sort(([, a], [, b]) => {
    const x = a[0], y = b[0];
    return puesto(ORDEN_DISC, x["Disciplina"]) - puesto(ORDEN_DISC, y["Disciplina"])
        || compara(x["Disciplina"], y["Disciplina"])
        || puesto(ORDEN_CAT, x["Categoría"]) - puesto(ORDEN_CAT, y["Categoría"])
        || compara(x["Categoría"], y["Categoría"])
        || puesto(ORDEN_FASE, x["Fase"]) - puesto(ORDEN_FASE, y["Fase"])
        || compara(x["Fase"], y["Fase"]);
  });

  // Devuelve la rejilla de esta disciplina y categoría, creándola si hace falta
  const rejillaDe = (p) => {
    const d = M.sinAcentos(p["Disciplina"]), c = M.sinAcentos(p["Categoría"]);
    let sec = salida.querySelector(`[data-disc="${d}"]`);
    if (!sec) {
      sec = document.createElement("section");
      sec.className = "ge__disc";
      sec.dataset.disc = d;
      const h = document.createElement("h2");
      h.className = "ge__h2";
      h.textContent = (p["Disciplina"] || "").toUpperCase();
      sec.append(h);
      salida.append(sec);
    }
    let grupo = sec.querySelector(`[data-cat="${c}"]`);
    if (!grupo) {
      grupo = document.createElement("div");
      grupo.className = "ge__cat";
      grupo.dataset.cat = c;
      const h = document.createElement("h3");
      h.className = "ge__h3";
      h.textContent = p["Categoría"] || "";
      const rej = document.createElement("div");
      rej.className = "ge__rejilla";
      grupo.append(h, rej);
      sec.append(grupo);
    }
    return grupo.querySelector(".ge__rejilla");
  };

  const ficha = (donde, titulo, sub, lienzo, blob, archivo, ajustes) => {
    const url = URL.createObjectURL(blob);
    const caja = document.createElement("div");
    caja.className = "ge__ficha";
    lienzo.className = "ge__lienzo";
    caja.append(lienzo);
    const pie = document.createElement("div");
    pie.className = "ge__pie";
    pie.innerHTML = `<p class="ge__t"></p><p class="ge__sub"></p>
      <div class="ge__acciones">
        <a class="ge__a" data-ver href="#">Ver</a>
        <a class="ge__a" download="${archivo}" href="${url}">Descargar</a>
      </div>`;
    pie.querySelector(".ge__t").textContent = titulo;
    pie.querySelector(".ge__sub").textContent = sub;
    const abrir = (e) => { e.preventDefault(); galeria.abrirVisor({ url, tipo: "imagen" }); };
    pie.querySelector("[data-ver]").addEventListener("click", abrir);
    lienzo.addEventListener("click", abrir);
    caja.append(pie);
    donde.append(caja);
    return { url, archivo, blob, ajustes };
  };

  /* ── Generar todo ── */
  // Monta los carteles de una prueba y los deja en su sitio de la rejilla.
  // La usan tanto el lote como «Rehacer».
  const montarPrueba = async (lista) => {
    const donde = rejillaDe(lista[0]);
    const d = await montar(lista);
    const base = M.nombreArchivo(d.titulo);
    // Con qué se montó, para poder rehacerlo luego desde el servidor
    const comoSeHizo = {
      disciplina: lista[0]["Disciplina"], categoria: lista[0]["Categoría"],
      fase: lista[0]["Fase"], titulo: d.titulo, puestos: d.cuantos,
    };
    const salidos = [];

    await M.pintarPodio(tctx, d.podio);
    salidos.push(ficha(donde, d.titulo, `Podio · ${d.sinFoto ? d.sinFoto + " sin foto" : "con sus fotos"}`,
      miniatura(), await aBlob(), `${base}-podio.png`, { ...comoSeHizo, cartel: "podio" }));

    if (d.cuantos > P.puestos.length) {
      await M.pintarTop10(tctx, d.top);
      salidos.push(ficha(donde, d.titulo, `Top ${Math.min(d.cuantos, T.filas.cuantas)}`,
        miniatura(), await aBlob(), `${base}-top10.png`, { ...comoSeHizo, cartel: "top10" }));
    }
    return salidos;
  };

  let parar = false;

  btnGenerar.addEventListener("click", async () => {
    // El mismo botón para: mientras trabaja dice «parar»
    if (btnGenerar.dataset.trabajando) { parar = true; btnGenerar.textContent = "Parando…"; return; }

    const m = pruebasBuenas();
    if (!m.size) return;
    btnGenerar.dataset.trabajando = "1";
    btnTodo.hidden = true; btnSubir.hidden = true;
    salida.innerHTML = "";
    hechos = [];
    parar = false;

    const pruebas = ordenadas(m);
    let montadas = 0;
    for (let i = 0; i < pruebas.length; i++) {
      if (parar) break;
      const lista = pruebas[i][1];
      estadoTxt.textContent = `Montando ${i + 1} de ${pruebas.length}: ${M.cat(lista[0])}…`;
      btnGenerar.textContent = `Montando ${i + 1} de ${pruebas.length} · parar`;
      hechos.push(...await montarPrueba(lista));
      montadas++;
    }

    estadoTxt.innerHTML = "";
    estadoTxt.append(parar
      ? `Parado, ${hechos.length} carteles de ${montadas} ${montadas === 1 ? "prueba" : "pruebas"}. `
      : `${hechos.length} carteles de ${pruebas.length} ${pruebas.length === 1 ? "prueba" : "pruebas"}. `);
    if (hechos.length) {
      const ir = document.createElement("button");
      ir.type = "button"; ir.className = "ge__enlace";
      ir.textContent = `Ver los ${hechos.length} ↓`;
      ir.addEventListener("click", () =>
        salida.scrollIntoView({ behavior: "smooth", block: "start" }));
      estadoTxt.append(ir);
    }
    delete btnGenerar.dataset.trabajando;
    btnGenerar.textContent = "Generar carteles";
    parar = false;
    btnTodo.hidden = hechos.length === 0;
    // En ensayo no se guarda: los carteles son de mentira y no deben acabar
    // mezclados con los buenos en el servidor
    btnSubir.hidden = hechos.length === 0 || ensayo;
    if (ensayo && hechos.length) {
      estadoTxt.append(" Son de ensayo: no se pueden guardar en el servidor.");
    }
  });

  /* ── Ensayo: puestos inventados, sólo en memoria ──
     Para ver cómo quedan los carteles antes de que se compita. No escribe
     nada en la hoja ni en el servidor: en cuanto se recarga la página, se va. */
  const btnEnsayo = document.querySelector("[data-ensayo]");

  btnEnsayo.addEventListener("click", () => {
    if (!fichas.length) return;
    // Las tres pruebas con más gente, para que el ensayo sea corto pero real
    const porPrueba = new Map();
    for (const p of fichas) {
      if (!esDeFaseBuena(p)) continue;
      const k = [p["Disciplina"], p["Categoría"], p["Fase"]].join("\u0001");
      if (!porPrueba.has(k)) porPrueba.set(k, []);
      porPrueba.get(k).push(p);
    }
    const elegidas = [...porPrueba.values()]
      .filter((v) => v.length >= 3)
      .sort((a, b) => b.length - a.length)
      .slice(0, 3);

    if (!elegidas.length) {
      estadoTxt.textContent = `No hay ninguna ${fasesBuenas().length > 1 ? "final ni semifinal" : "final"} con tres participantes o más.`;
      return;
    }
    for (const v of elegidas) v.slice(0, 10).forEach((p, i) => { p["Puesto"] = String(i + 1); });

    ensayo = true;
    btnGenerar.disabled = false;
    btnEnsayo.disabled = true;
    salida.innerHTML = "";
    hechos = [];
    btnTodo.hidden = true; btnSubir.hidden = true;
    estadoTxt.textContent = `Ensayo: puestos inventados en ${elegidas.length} pruebas, ` +
      "sólo aquí. Ni la hoja ni el servidor se enteran. Recarga para deshacerlo.";
  });

  btnSubir.addEventListener("click", async () => {
    btnSubir.disabled = true;
    const original = btnSubir.textContent;
    try {
      for (let i = 0; i < hechos.length; i++) {
        btnSubir.textContent = `Guardando ${i + 1} de ${hechos.length}…`;
        await galeria.subir(hechos[i].blob, hechos[i].archivo, hechos[i].ajustes);
      }
      await galeria.listar();
      estadoTxt.textContent = `${hechos.length} carteles guardados en el servidor.`;
    } catch (e) {
      estadoTxt.textContent = "No se pudo guardar: " + e.message;
    } finally { btnSubir.disabled = false; btnSubir.textContent = original; }
  });

  document.querySelector("[data-refrescar]").addEventListener("click", () => galeria.listar());

  btnTodo.addEventListener("click", async () => {
    btnTodo.disabled = true;
    for (const h of hechos) {
      const a = document.createElement("a");
      a.href = h.url; a.download = h.archivo; a.click();
      await new Promise((r) => setTimeout(r, 450));
    }
    btnTodo.disabled = false;
  });

  // Cuántas pruebas hay listas con el filtro puesto
  const recontar = () => {
    if (!fichas.length) return;
    const m = pruebasBuenas();
    const todas = M.pruebas(fichas).size;
    btnGenerar.disabled = m.size === 0 && !ensayo;
    const fases = fasesBuenas().length > 1 ? "finales y semifinales" : "finales";
    estadoTxt.textContent = m.size
      ? `${fichas.length} participantes, ${m.size} ${m.size === 1 ? "prueba" : "pruebas"} con puestos entre las ${fases}.`
      : todas
        ? `Hay ${todas} ${todas === 1 ? "prueba" : "pruebas"} con puestos, pero ninguna entre las ${fases}.`
        : `${fichas.length} participantes, pero ningún puesto todavía. En cuanto rellenes la columna «Puesto» de la hoja, el botón se activa solo.`;
  };

  document.querySelector("[data-con-semis]").addEventListener("change", recontar);

  /* ── Arranque ── */
  M.precargar();
  galeria.listar();
  fetch(C.HOJA.url).then((r) => r.text()).then((t) => {
    fichas = M.leerCSV(t).map((p, i) => ({ ...p, __i: i }));
    recontar();
  }).catch((e) => (estadoTxt.textContent = "No se pudo leer la hoja: " + e.message));
</script>
