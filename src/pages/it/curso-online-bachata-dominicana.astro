---
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
import WaitlistForm from "../../components/WaitlistForm.astro";
import Faq from "../../components/Faq.astro";

const faqs = [
  { q: "Quando sarà disponibile il corso online di bachata dominicana?", a: "È in preparazione e aprirà prossimamente. Se lasci la tua email nella lista d’attesa, ti avviso appena ho una data, prima di annunciarlo pubblicamente." },
  { q: "Come funzionerà il corso online?", a: "Saranno lezioni in diretta su Zoom che resteranno registrate: se non puoi partecipare, le guardi quando vuoi e le ripassi al tuo ritmo." },
  { q: "Serve un partner per il corso online?", a: "No. Il corso lavorerà sulla base individuale della bachata dominicana: passo, conteggio, musicalità e movimento del corpo. Potrai seguirlo da solo o da sola da casa." },
  { q: "Che livello serve per iniziare?", a: "Ci saranno contenuti dal livello medio, e se parti da zero ti orienterò nella prima lezione così segui il corso senza perderti." },
  { q: "Posso iniziare a ballare nel frattempo?", a: `Sì. Mentre preparo il corso puoi venire alle <a href="/it/clases-presenciales/">lezioni in presenza</a> a Barcellona e Ibiza.` },
];

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Corso online di bachata dominicana",
  description: "Corso online di bachata dominicana (tradizionale) con Évelyn «La Negra»: passo, musicalità e sapore dalla radice. In preparazione — disponibile prossimamente.",
  provider: { "@type": "Organization", name: "La Negra Salsa", url: new URL("/", Astro.site).href },
  inLanguage: "it",
  courseMode: "online",
  author: { "@type": "Person", name: "Évelyn Viana Lovera", alternateName: "La Negra", url: new URL("/it/evelyn-la-negra/", Astro.site).href },
};
---
<Base
  title="Corso online di bachata dominicana · Prossimamente con La Negra"
  description="Corso online di bachata dominicana con Évelyn «La Negra», in preparazione. Lasciami la tua email e ti avviso appena apre: passo, musicalità e sapore dalla radice."
  transparentHeader={true}
>
  <PageIntro
    kicker="Prossimamente"
    title="Corso online di <em>bachata dominicana</em>."
    lead={[
      "Lo sto creando proprio ora: bachata dominicana in diretta su Zoom, da dove vuoi — e con le lezioni registrate per te.",
      "Lasciami la tua email e sarai tra i primi a sapere quando apre.",
    ]}
    cue="Cosa sto preparando"
    narrow={true}
  />

  <section class="section">
    <div class="container readcol">
      <p class="eyebrow">In costruzione</p>
      <h2>Il corso non è ancora aperto</h2>
      <p>Sto registrando e ordinando il materiale perché imparare la bachata dominicana da casa
        assomigli il più possibile ad avermi davanti. Preferisco farlo bene che farlo in fretta,
        quindi non c’è ancora una data definita — ma è in corso.</p>

      <h3>Cosa sto preparando</h3>
      <div class="courses">
        <div class="course"><h3>Bachata Tradizionale</h3><p>Livello medio</p></div>
        <div class="course"><h3>Salsa · Movimento del corpo</h3><p>Livello medio</p></div>
      </div>

      <h3>Come funzionerà</h3>
      <ul class="feats">
        <li><strong>Lezioni in diretta su Zoom</strong>, per poterti correggere sul momento.</li>
        <li><strong>Tutto resta registrato</strong>: se non puoi partecipare, lo guardi quando vuoi.</li>
        <li><strong>Senza partner</strong>: la base —passo, conteggio, musicalità e corpo— si lavora da soli.</li>
      </ul>
    </div>
  </section>

  <WaitlistForm name="lista-espera-online-it" />

  <section class="section">
    <div class="container readcol">
      <p class="eyebrow">Nel frattempo</p>
      <h2>Puoi già iniziare a ballare</h2>
      <p>Non devi aspettare il corso per metterti in moto:</p>
      <ul class="feats">
        <li><a href="/it/clases-presenciales/"><strong>Lezioni in presenza</strong></a> — Barcellona e Ibiza, ogni settimana.</li>
        <li><a href="/it/evelyn-la-negra/"><strong>Chi è La Negra</strong></a> — trent’anni di pista, dalla radice.</li>
      </ul>
    </div>
  </section>

  <Faq items={faqs} title="Domande sul corso online" kicker="Dubbi" />

  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
</Base>

<style>
  .courses{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:18px 0 8px}
  .course{background:#0f0f10;border:1px solid var(--line);border-radius:12px;padding:26px}
  .course h3{color:#fff;font-weight:700;margin:0 0 .3em}
  .course p{margin:0}
  .feats{padding-left:1.2em;line-height:1.7;color:var(--text)}
  .feats li{margin-bottom:.5em}
  .feats strong{color:#fff}
  .feats a{color:var(--acc)}
  @media (max-width:600px){.courses{grid-template-columns:1fr}}
</style>
