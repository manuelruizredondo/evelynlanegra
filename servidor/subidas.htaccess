# Va dentro de «subidas», renombrado a .htaccess
#
# 1) Permite que evelynlanegra.com dibuje estas fotos en un lienzo y pueda
#    descargar el cartel. Sin esto el navegador bloquea la exportación.
# 2) Impide que algo subido aquí se ejecute.
#
# Todo va dentro de <IfModule>: si el módulo no estuviera, Apache lo ignora
# en vez de devolver un error 500.

<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|gif|avif|mp4|webm|mov)$">
    Header set Access-Control-Allow-Origin "https://evelynlanegra.com"
    Header set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .php5 .php7 .php8
  RemoveType .php .phtml .phar .php5 .php7 .php8
</IfModule>
