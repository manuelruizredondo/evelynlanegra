---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
const wa = "https://api.whatsapp.com/send?phone=34621074054&text=Hola%20Evelyn,%20quiero%20info%20de%20la%20formacion%20de%20Bachata%20Tradicional";

const clases = [
  { n: "01", title: "Historia", meta: "2h · Teórica", d: "Acepciones del vocablo bachata, los precursores y ritmos que la originaron, origen y evolución de la bachata." },
  { n: "02", title: "Musicalidad", meta: "2h · Teórica", d: "Lenguaje musical básico (pulso, ritmo, compás, tempo), la importancia de los patrones rítmicos e instrumentos." },
  { n: "03", title: "Desmontando el básico", meta: "2h · Práctica", d: "Diferencias entre la bachata auténtica, la moderna y la sensual. Elementos para conseguir un estilo: pisada y conteo." },
  { n: "04", title: "Combinaciones y variaciones", meta: "2h · Práctica", d: "Sistema lineal, cuadrado y diagonal. Pasos básicos y su musicalidad. El patín como recurso." },
  { n: "05", title: "Baile en pareja", meta: "2h+1 · Teórico-práctica", d: "La importancia de los brazos y la conducción. La «dominicana» de competición y en el social." },
];

const testimonios = [
  { img: "/img/2021/02/Jose-Luis-Chaves.jpg", name: "José Luis Chaves", sub: "de Chaves y Silvia", text: "Da igual qué estilo bailes… este curso te va a servir sí o sí. No es solo que ya sepas tradicional: también aprendes a respirar y a sentir la música." },
  { img: "/img/2021/02/Judith-Cordero-Pereiro.jpg", name: "Judith Cordero Pereiro", sub: "", text: "Felices nosotros de poder seguir conociendo las raíces y que lo hagas todo tan fácil. Escucharte es quedarse embobado." },
  { img: "/img/2021/02/Gigi-Bellomo.jpg", name: "Gigi Bellomo", sub: "", text: "Gracias a esta experiencia puedo decir que hay pocas personas en este mundo que aman lo que hacen como tú." },
  { img: "/img/2021/02/Sylvia-Pires.jpg", name: "Sylvia Pires", sub: "", text: "Carisma, búsqueda de la perfección, garra, humor, inteligencia, amor y pasión por lo que haces." },
  { img: "/img/2021/02/Yaimelys-Sonylus.jpg", name: "Yaimelys Sonylus", sub: "", text: "Hice la 1ª formación con esta gran maestra y ya estoy haciendo la 2ª. Es, sin duda, una maestra de maestros." },
];
---
<Base
  title="Profesora de bachata dominicana: formación y máster de profesorado"
  description="Fórmate como profesor de bachata dominicana con Évelyn «La Negra»: máster de bachata tradicional con metodología propia y diploma. Maestra de maestros desde la raíz."
  transparentHeader={true}
>
  <PageIntro
    kicker="Máster en Bachata Tradicional"
    title="Conviértete en <em>profesor</em> de bachata dominicana."
    lead={[
      "Formación reglada con metodología propia: la titulación de referencia en bachata tradicional.",
      "Maestra de maestros — más de dos décadas enseñando desde la raíz.",
    ]}
    cue="El programa"
  />

  <section class="section">
    <div class="container prose">
      <h2>Bachata Tradicional 1 y 2</h2>
      <p><strong>Incluye diploma acreditativo</strong> + dossier de 50 páginas de contenido original.</p>
      <h3>Descripción</h3>
      <p>Clases online (10 horas) por plataforma Zoom, dossier de 50 páginas de contenido original y
        correcciones individuales.</p>

      <h3>Temario</h3>
      <ol class="syllabus">
        {clases.map((c) => (
          <li class="syllabus__item">
            <span class="syllabus__num">{c.n}</span>
            <div class="syllabus__body">
              <div class="syllabus__head">
                <h4>{c.title}</h4>
                <span class="syllabus__meta">{c.meta}</span>
              </div>
              <p>{c.d}</p>
            </div>
          </li>
        ))}
      </ol>

      <h3>Horario</h3>
      <p>5 semanas: dos horas semanales continuas. Mañanas o mediodías a escoger entre miércoles,
        jueves o domingos (según demanda). Podrían abrirse otros horarios según demanda.</p>

      <h3>Cómo enseño</h3>
      <p>Un consejo que doy siempre a los profesores: <strong>no puedes darlo todo tan técnico</strong>.
        Si abrumas a la gente con teoría, se agobia y se va a otra escuela. Mi proporción es
        <strong>70/30</strong>: un 70&nbsp;% de clase práctica y un 30&nbsp;% para explicar qué están
        haciendo y por qué.</p>
      <p>Y dentro de ese 30&nbsp;% hay algo que me importa mucho: <strong>nombrar al músico</strong>.
        Decir «esta canción es de Zacarías Ferreira», «esto es Romeo», para que el alumno le vaya
        cogiendo cariño a quien hay detrás. Los salseros saben quién es El Gran Combo o Joe Arroyo;
        en cambio hay una generación de bachateros que se crió con <em>remixes</em> —con bongó
        electrónico— y a la que nadie le enseñó a querer a los músicos. Sin ellos no hay clase, ni
        show, ni social.</p>

      <h3>Advertencia</h3>
      <p>Éste no es un título que te convierta en profesor (si entras en el curso es porque ya lo eres).
        El diploma es un <strong>Certificado de Capacitación</strong> específico que se otorga por haber
        aprobado con alto rendimiento el programa «Enseñanza de Bachata Dominicana».</p>
    </div>
  </section>

  <section class="section" style="background:#0f0f10;color:#fff">
    <div class="container">
      <h2 style="color:#fff">Testimonios</h2>
      <p style="opacity:.8">Lee lo que dicen de mí</p>
    </div>
    <div class="tswiper" data-tswiper>
      <div class="tswiper__track">
        {testimonios.map((t) => (
          <figure class="tcard">
            <img class="tcard__img" src={t.img} alt={t.name} loading="lazy" />
            <div class="tcard__body">
              <blockquote>«{t.text}»</blockquote>
              <figcaption><strong>{t.name}</strong>{t.sub && <span> · {t.sub}</span>}</figcaption>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactForm name="contacto-formacion" title="Más información" note="Contacta conmigo para recibir más información sobre este curso y próximas actividades." />
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Máster en Bachata Tradicional — Enseñanza de Bachata Dominicana",
  description: "Formación de profesorado en bachata dominicana con metodología propia, dossier de 50 páginas y diploma acreditativo. Bachata Tradicional 1 y 2, clases online por Zoom.",
  provider: { "@type": ["Organization", "DanceSchool"], name: "La Negra Salsa", sameAs: site.instagram },
  inLanguage: "es",
  courseMode: "online",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    reviewCount: String(testimonios.length),
    bestRating: "5",
  },
  review: testimonios.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.name },
    reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5" },
    reviewBody: t.text,
  })),
})} />

<style>
  .syllabus{list-style:none;margin:18px 0 0;padding:0;border-top:1px solid var(--line)}
  .syllabus__item{display:grid;grid-template-columns:auto 1fr;gap:30px;padding:26px 4px;
    border-bottom:1px solid var(--line);align-items:start;transition:background .2s}
  .syllabus__item:hover{background:rgba(255,255,255,.02)}
  .syllabus__num{font-family:var(--serif);font-style:italic;font-weight:500;font-size:2.6rem;
    line-height:.9;color:var(--acc);min-width:1.4em}
  .syllabus__head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:7px}
  .syllabus__head h4{margin:0;font-size:1.3rem;color:#fff;font-weight:700}
  .syllabus__meta{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;
    color:var(--muted);border:1px solid var(--line);padding:4px 11px;border-radius:999px;white-space:nowrap}
  .syllabus__body p{margin:0;color:var(--text);max-width:62ch;line-height:1.55}
  @media (max-width:600px){
    .syllabus__item{grid-template-columns:1fr;gap:6px;padding:22px 4px}
    .syllabus__num{font-size:1.9rem}
  }
  /* Swiper de testimonios (scroll-snap nativo + autoavance lento) */
  .tswiper{margin-top:38px;overflow:hidden}
  .tswiper__track{display:flex;gap:26px;overflow-x:auto;scroll-snap-type:x mandatory;
    padding:6px clamp(20px,8vw,140px);scroll-padding-inline:clamp(20px,8vw,140px);
    scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch}
  .tswiper__track::-webkit-scrollbar{display:none}
  .tcard{margin:0;flex:0 0 clamp(300px,72vw,640px);scroll-snap-align:center;
    display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;text-align:left;
    background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:18px;padding:30px 34px}
  .tcard__img{width:116px;height:116px;border-radius:50%;object-fit:cover;flex-shrink:0}
  .tcard__body{min-width:0}
  .tcard blockquote{margin:0 0 14px;font-style:italic;color:#c9c9cc;font-size:1.02rem;line-height:1.5}
  .tcard figcaption{color:var(--acc);font-size:.9rem;font-weight:700}
  .tcard figcaption span{color:#c9c9cc;font-weight:400}
  @media (max-width:600px){
    .tcard{grid-template-columns:1fr;gap:16px;text-align:center;padding:26px 22px}
    .tcard__img{margin:0 auto}
  }
</style>

<script>
  // Autoavance lento del swiper de testimonios (scroll-snap nativo, pausable)
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-tswiper]").forEach((root) => {
    const track = root.querySelector<HTMLElement>(".tswiper__track");
    if (!track) return;
    const cards = Array.from(track.children) as HTMLElement[];
    if (cards.length < 2 || reduce) return;

    let i = 0;
    let paused = false;
    const go = (n: number) => {
      i = (n + cards.length) % cards.length;
      const card = cards[i];
      const left = card.offsetLeft - (track.clientWidth - card.clientWidth) / 2;
      track.scrollTo({ left, behavior: "smooth" });
    };

    // Sincroniza el índice si el usuario arrastra manualmente
    let syncTimer: number | undefined;
    track.addEventListener("scroll", () => {
      window.clearTimeout(syncTimer);
      syncTimer = window.setTimeout(() => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let best = 0, dist = Infinity;
        cards.forEach((c, idx) => {
          const cc = c.offsetLeft + c.clientWidth / 2;
          const d = Math.abs(cc - center);
          if (d < dist) { dist = d; best = idx; }
        });
        i = best;
      }, 120);
    }, { passive: true });

    const pause = () => { paused = true; };
    const resume = () => { paused = false; };
    root.addEventListener("mouseenter", pause);
    root.addEventListener("mouseleave", resume);
    root.addEventListener("pointerdown", pause);
    root.addEventListener("pointerup", resume);
    root.addEventListener("focusin", pause);
    root.addEventListener("focusout", resume);

    window.setInterval(() => { if (!paused) go(i + 1); }, 4800);
  });
</script>
